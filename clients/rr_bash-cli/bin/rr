#!/usr/bin/env bash
# rr - RR Registry command line client (bash). Maintainer: m5ike.
# All operations go through the generated API library lib/rr-api.sh.
set -o pipefail

_rr_self="${BASH_SOURCE[0]}"
while [ -L "$_rr_self" ]; do
  _rr_dir="$(cd -P "$(dirname "$_rr_self")" && pwd)"
  _rr_self="$(readlink "$_rr_self")"
  [[ "$_rr_self" != /* ]] && _rr_self="$_rr_dir/$_rr_self"
done
RR_HOME="$(cd -P "$(dirname "$_rr_self")/.." && pwd)"
# shellcheck source=../lib/rr-common.sh
. "$RR_HOME/lib/rr-common.sh"
# shellcheck source=../lib/rr-api.sh
. "$RR_HOME/lib/rr-api.sh"
rr_config_load

RR_CLI_VERSION="$RR_API_VERSION"

usage() {
  cat <<EOF
rr $RR_CLI_VERSION - RR Registry CLI  (server: $RR_SERVER)

Použití: rr <příkaz> [argumenty]

Připojení
  config [server <url>] [token <t>]     zobrazit / nastavit připojení (~/.config/rr/config)
  login [uživatel]                      přihlásit se (uloží token)
  logout | whoami | status | version
  npmrc [repo]                          vypíše nastavení pro ~/.npmrc

Repozitáře
  repo list | show <repo>
  repo create <name> [npm|generic|docker|git|group] [popis] [key=value...]
                                        např. repo create vse group "Vše" members=npm,internal deployTo=internal
  repo update <repo> key=value...       (description, public, allowPublish, quotaMb, immutable,
                                         autoCreate, members=a,b, deployTo)
  repo policy <repo> key=value...       pravidla čištění: enabled maxVersions maxAgeDays
                                         prereleaseOnly pattern intervalHours
  repo acl <repo> uživatel=none|read|publish...   přístupová práva (prázdné = zrušit)
  repo cleanup <repo> [--dry-run]       spustí čištění dle pravidel
  repo stats <repo>                     statistiky stahování
  repo delete <repo> [--purge]

Balíčky (npm repozitáře)
  pkg list <repo> [filtr]               pkg show <repo> <balíček>
  pkg publish <repo> <soubor.tgz> [tag] pkg download <repo> <balíček> <verze> [výstup]
  pkg delete <repo> <balíček> [verze]   pkg deprecate <repo> <balíček> <verze> <zpráva>
  pkg tag <repo> <balíček> <tag> <verze>
  pkg untag <repo> <balíček> <tag>
  search <dotaz> [repo]

Soubory repozitáře
  fs tree <repo> [cesta] [hloubka]      fs stat <repo> <cesta>
  fs cat <repo> <cesta>                 fs get <repo> <cesta> [výstup]
  fs put <repo> <cesta> <soubor>        fs rm <repo> <cesta>     fs mkdir <repo> <cesta>

Git repozitáře (klonování: git clone <server>/git/<název>.git)
  git list <repo> [filtr]               git show <repo> <název>
  git create <repo> <název> [popis]     git rm <repo> <název>
  git import <repo> <název> <url> [--no-mirror] [--token T] [--interval s]
  git github <repo> <owner> [--token T] [--org|--mine] [--filter glob] [--no-mirror]
             [--forks] [--archived] [--limit N] [--prefix P] [--interval s]
  git log <repo> <název> [ref] [počet]  git ls <repo> <název> [ref] [cesta]
  git cat <repo> <název> <cesta> [ref]  git archive <repo> <název> [ref] [výstup] [tar.gz|zip]
  git sync <repo> <název> [pull|push|both]
  git mirror <repo> <název> <url>|off [--token T] [--interval s] [--ttl s]
  git protect <repo> <název> <větev,větev|"">
  git push-mirror add <repo> <název> <url> [--token T] [--user U] [--create] [--public] [--branches]
  git push-mirror rm <repo> <název> <id>

Docker image
  image list <repo> | tags <repo> <image> | rm <repo> <image> <tag> | gc <repo> [--untagged]

Webhooky, události, replikace, úlohy
  webhook list | add name=.. url=.. [events=npm.*,git.push] [repos=..] [secret=..] [format=json|slack|discord]
  webhook update <id> key=value... | rm <id> | test <id> | deliveries [id]
  events [počet]                        poslední události
  replication list [status] | retry <id>
  task list | run <id>

Směrování (routing plugin) a cache
  route list | show <id>
  route add name=.. target=.. [when=always|notfound|push] [matchType=prefix|glob|regex|contains|exact]
            [matchOn=package|path|url] [pattern=..] [repo=..] [repoType=..] [key=..] [cacheTtl=..]
            [priority=..] [token=..] [username=..] [replicateDeletes=true] [gitMode=mirror|branches]
            [createMissing=true]
  route update <id> key=value...        route delete <id>
  route enable <id> | disable <id>      route test <cesta> [repo] [klíč] [metoda]
  cache stats | list [filtr] | purge [--expired] [filtr] | rm <klíč>

Uživatelé, tokeny, nastavení
  user list | add <jméno> <heslo> [role] [email] | passwd <jméno> <heslo> | role <jméno> <role> | delete <jméno>
  token list | create <název> [--readonly] [--user <u>] [--ttl <s>] | revoke <id>
  settings [get] | settings set key=value...
  logs [počet] | plugins | clients | rebuild-clients

Nízkoúrovňové
  api                                   seznam všech API operací
  call <operace> [args...]              přímé volání, např. rr call list_repos

Proměnné: RR_SERVER, RR_TOKEN, RR_CONFIG, RR_CURL_OPTS
EOF
}

need() { local n="$1"; shift; [ "$#" -ge "$n" ] || rr_die "chybí argumenty (viz rr help)"; }

cmd_config() {
  if [ $# -eq 0 ]; then
    echo "config:  $RR_CONFIG"
    echo "server:  $RR_SERVER"
    if [ -n "$RR_TOKEN" ]; then echo "token:   ${RR_TOKEN:0:7}…"; else echo "token:   (není)"; fi
    return
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      server) RR_SERVER="$2"; shift 2 ;;
      token) RR_TOKEN="$2"; shift 2 ;;
      *) rr_die "neznámá volba $1 (server|token)" ;;
    esac
  done
  rr_config_save
  echo "uloženo do $RR_CONFIG"
}

cmd_login() {
  local user="${1:-}" pass
  [ -n "$user" ] || read -r -p "Uživatel: " user
  read -r -s -p "Heslo: " pass; echo
  local body out
  body=$(rr_json_obj "username==$user" "password==$pass" "tokenName=rr-cli" "ttl=2592000")
  out=$(RR_TOKEN="" rr_api_login "$body") || exit 1
  RR_TOKEN=$(printf '%s' "$out" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
  [ -n "$RR_TOKEN" ] || rr_die "přihlášení selhalo"
  RR_USER="$user"
  rr_config_save
  echo "přihlášen jako $user, token uložen do $RR_CONFIG"
}

kv_json() { rr_json_obj "$@"; }

cmd_repo() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then
        rr_api_list_repos | jq -r '(["NAME","TYPE","PACKAGES","PUBLIC","DEFAULT","DESCRIPTION"]|@tsv),(.[]|[.name,.type,(.packages//"-"),.public,.default,.description]|@tsv)' | column -t -s $'\t'
      else rr_api_list_repos; fi ;;
    show) need 1 "$@"; rr_api_get_repo "$1" | rr_json ;;
    create|add) need 1 "$@"; rr_api_create_repo "$(kv_json "name=$1" "type=${2:-npm}" "description==${3:-}" "${@:4}")" | rr_json ;;
    update) need 1 "$@"; local r="$1"; shift; rr_api_update_repo "$r" "$(kv_json "$@")" | rr_json ;;
    delete|rm) need 1 "$@"; local q=""; [ "${2:-}" = "--purge" ] && q="purge=1"; rr_api_delete_repo "$1" "$q" | rr_json ;;
    policy|retention) need 2 "$@"; local r="$1"; shift; rr_api_update_repo "$r" "{\"cleanup\":$(kv_json "$@")}" | rr_json '{name, cleanup}' ;;
    acl)
      need 1 "$@"; local r="$1"; shift
      local acl='{}'; [ $# -gt 0 ] && acl="$(kv_json "$@")"
      rr_api_update_repo "$r" "{\"acl\":$acl}" | rr_json '{name, public, acl}' ;;
    cleanup)
      need 1 "$@"; local dry=false; [ "${2:-}" = "--dry-run" ] && dry=true
      if rr_have_jq; then rr_api_run_cleanup "$1" "{\"dryRun\":$dry}" | jq -r '"dryRun: \(.dryRun)  freed: \(.freedBytes) B", (.actions[] | "  \(.action) \(.target)  (\(.reason // ""))")'
      else rr_api_run_cleanup "$1" "{\"dryRun\":$dry}"; fi ;;
    stats)
      need 1 "$@"
      if rr_have_jq; then rr_api_get_repo_stats "$1" | jq -r '"celkem: \(.total)  poslední: \(.last // "-")", "nejstahovanější:", (.top[] | "  \(.downloads)\t\(.item)")'
      else rr_api_get_repo_stats "$1"; fi ;;
    *) rr_die "neznámý příkaz repo $sub" ;;
  esac
}

cmd_pkg() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list|ls)
      need 1 "$@"
      if rr_have_jq; then
        rr_api_list_packages "$1" "$(rr_query "q=${2:-}")" | jq -r '(["NAME","LATEST","VERSIONS","MODIFIED"]|@tsv),(.[]|[.name,(.version//""),(.versions//""),.modified]|@tsv)' | column -t -s $'\t'
      else rr_api_list_packages "$1" "$(rr_query "q=${2:-}")"; fi ;;
    show|info)
      need 2 "$@"
      if rr_have_jq; then
        rr_api_get_package "$1" "$2" | jq '{name, description, "dist-tags", versions: (.versions|keys), maintainers, time: {created: .time.created, modified: .time.modified}}'
      else rr_api_get_package "$1" "$2"; fi ;;
    publish|upload) need 2 "$@"; rr_api_upload_package "$1" "$2" "$(rr_query "tag=${3:-}")" | rr_json ;;
    delete|rm|unpublish)
      need 2 "$@"
      if [ -n "${3:-}" ]; then rr_api_delete_version "$1" "$2" "$3" | rr_json; else rr_api_delete_package "$1" "$2" | rr_json; fi ;;
    tag) need 4 "$@"; rr_api_set_dist_tag "$1" "$2" "$3" "$(kv_json "version==$4")" | rr_json ;;
    untag) need 3 "$@"; rr_api_delete_dist_tag "$1" "$2" "$3" | rr_json ;;
    deprecate) need 3 "$@"; rr_api_deprecate_version "$1" "$2" "$3" "$(kv_json "message==${4:-}")" | rr_json ;;
    download)
      need 3 "$@"
      local out="${4:-$(basename "$2")-$3.tgz}"
      RR_OUT="$out" rr_api_download_tarball "$1" "$2" "$3" && echo "uloženo: $out" ;;
    *) rr_die "neznámý příkaz pkg $sub (list|show|publish|download|delete|tag|untag|deprecate)" ;;
  esac
}

cmd_search() {
  need 1 "$@"
  if rr_have_jq; then
    rr_api_search "$(rr_query "q=$1" "repo=${2:-}")" | jq -r '(["NAME","VERSION","REPO","DESCRIPTION"]|@tsv),(.objects[]|[.package.name,.package.version,.repository,.package.description]|@tsv)' | column -t -s $'\t'
  else rr_api_search "$(rr_query "q=$1" "repo=${2:-}")"; fi
}

print_tree() {
  if rr_have_jq; then
    jq -r 'def walk_tree(ind): (ind + (if .type=="dir" then "📁 " else "📄 " end) + .name + (if .type=="file" then "  (" + (.size|tostring) + " B)" else "" end)), (.children // [] | .[] | walk_tree(ind + "   ")); walk_tree("")'
  else cat; fi
}

cmd_fs() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    tree|ls) need 1 "$@"; rr_api_tree "$1" "$(rr_query "path=${2:-/}" "depth=${3:-2}")" | print_tree ;;
    stat) need 2 "$@"; rr_api_stat "$1" "$(rr_query "path=$2")" | rr_json ;;
    cat) need 2 "$@"; rr_api_read_file "$1" "$(rr_query "path=$2")" ;;
    get) need 2 "$@"; local out="${3:-$(basename "$2")}"; RR_OUT="$out" rr_api_read_file "$1" "$(rr_query "path=$2")" && echo "uloženo: $out" ;;
    put) need 3 "$@"; rr_api_write_file "$1" "$3" "$(rr_query "path=$2")" | rr_json ;;
    rm) need 2 "$@"; rr_api_delete_file "$1" "$(rr_query "path=$2")" | rr_json ;;
    mkdir) need 2 "$@"; rr_api_mkdir "$1" "$(rr_query "path=$2")" | rr_json ;;
    *) rr_die "neznámý příkaz fs $sub (tree|stat|cat|get|put|rm|mkdir)" ;;
  esac
}

cmd_route() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then
        rr_api_list_routes | jq -r '(["ID","NAME","ON","WHEN","MATCH","PATTERN","REPO","KEY","TARGET","TTL"]|@tsv),(.[]|[.id,.name,.enabled,.when,(.matchOn+"/"+.matchType),(if .pattern=="" then "*" else .pattern end),.repo,(if .key=="" then "-" else .key end),.target,(.cacheTtl//"default")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_routes; fi ;;
    show) need 1 "$@"; rr_api_get_route "$1" | rr_json ;;
    add|create) rr_api_create_route "$(kv_json "$@")" | rr_json ;;
    update) need 1 "$@"; local id="$1"; shift; rr_api_update_route "$id" "$(kv_json "$@")" | rr_json ;;
    enable) need 1 "$@"; rr_api_update_route "$1" '{"enabled":true}' | rr_json ;;
    disable) need 1 "$@"; rr_api_update_route "$1" '{"enabled":false}' | rr_json ;;
    delete|rm) need 1 "$@"; rr_api_delete_route "$1" | rr_json ;;
    test) need 1 "$@"; rr_api_test_route "$(kv_json "path==$1" "repo==${2:-}" "key==${3:-}" "method==${4:-GET}")" | rr_json '{request, always, notfound}' ;;
    *) rr_die "neznámý příkaz route $sub" ;;
  esac
}

cmd_cache() {
  local sub="${1:-stats}"; shift || true
  case "$sub" in
    stats) rr_api_cache_stats | rr_json ;;
    list|ls)
      if rr_have_jq; then
        rr_api_list_cache "$(rr_query "q=${1:-}")" | jq -r '(["KEY","STATUS","SIZE","EXPIRED","URL"]|@tsv),(.entries[]|[.key[0:12],.status,.size,.expired,.url]|@tsv)' | column -t -s $'\t'
      else rr_api_list_cache "$(rr_query "q=${1:-}")"; fi ;;
    purge)
      local exp="" q=""
      for a in "$@"; do if [ "$a" = "--expired" ]; then exp=1; else q="$a"; fi; done
      rr_api_purge_cache "$(rr_query "expired=$exp" "q=$q")" | rr_json ;;
    rm) need 1 "$@"; rr_api_delete_cache_entry "$1" | rr_json ;;
    *) rr_die "neznámý příkaz cache $sub" ;;
  esac
}

cmd_user() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then rr_api_list_users | jq -r '(["NAME","ROLE","EMAIL"]|@tsv),(.[]|[.name,.role,(.email//"")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_users; fi ;;
    add|create) need 2 "$@"; rr_api_create_user "$(kv_json "name==$1" "password==$2" "role=${3:-publisher}" "email==${4:-}")" | rr_json ;;
    passwd) need 2 "$@"; rr_api_update_user "$1" "$(kv_json "password==$2")" | rr_json ;;
    role) need 2 "$@"; rr_api_update_user "$1" "$(kv_json "role=$2")" | rr_json ;;
    delete|rm) need 1 "$@"; rr_api_delete_user "$1" | rr_json ;;
    *) rr_die "neznámý příkaz user $sub" ;;
  esac
}

cmd_token() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then rr_api_list_tokens | jq -r '(["ID","NAME","USER","KIND","READONLY","PREVIEW","EXPIRES"]|@tsv),(.[]|[.id,.name,.user,.kind,.readonly,.preview,(.expires//"never")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_tokens; fi ;;
    create|add)
      local name="${1:-cli}" ro=false user="" ttl=0; shift || true
      while [ $# -gt 0 ]; do case "$1" in --readonly) ro=true; shift ;; --user) user="$2"; shift 2 ;; --ttl) ttl="$2"; shift 2 ;; *) shift ;; esac; done
      rr_api_create_token "$(kv_json "name==$name" "readonly=$ro" "user==$user" "ttl=$ttl")" | rr_json ;;
    revoke|rm|delete) need 1 "$@"; rr_api_revoke_token "$1" | rr_json ;;
    *) rr_die "neznámý příkaz token $sub" ;;
  esac
}

cmd_settings() {
  local sub="${1:-get}"; shift || true
  case "$sub" in
    get|show) rr_api_get_settings | rr_json ;;
    set) [ $# -gt 0 ] || rr_die "settings set key=value..."; rr_api_update_settings "$(kv_json "$@")" | rr_json ;;
    *) rr_die "neznámý příkaz settings $sub" ;;
  esac
}

# parse --flag value options into OPT_<flag> variables, positional args into ARGS
parse_opts() {
  ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --token|--interval|--ttl|--filter|--limit|--prefix|--user) eval "OPT_${1#--}=\"\$2\""; shift 2 ;;
      --*) eval "OPT_$(printf '%s' "${1#--}" | tr '-' '_')=1"; shift ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}

cmd_git() {
  local sub="${1:-list}"; shift || true
  OPT_token=""; OPT_interval=""; OPT_ttl=""; OPT_filter=""; OPT_limit=""; OPT_prefix=""; OPT_user=""
  OPT_no_mirror=""; OPT_org=""; OPT_user_kind=""; OPT_mine=""; OPT_forks=""; OPT_archived=""; OPT_create=""; OPT_public=""; OPT_branches=""
  parse_opts "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"
  case "$sub" in
    list|ls-repos)
      need 1 "$@"
      if rr_have_jq; then
        rr_api_list_git_repos "$1" "$(rr_query "q=${2:-}")" | jq -r '(["NAME","MIRROR","PUSH-MIRRORS","DESCRIPTION"]|@tsv),(.[]|[.name,(if .mirror then "\(.mirror.status) \(.mirror.lastSync // "")" else "-" end),.pushMirrors,.description]|@tsv)' | column -t -s $'\t'
      else rr_api_list_git_repos "$1" "$(rr_query "q=${2:-}")"; fi ;;
    show|info)
      need 2 "$@"
      if rr_have_jq; then
        rr_api_get_git_repo "$1" "$2" | jq -r '"\(.name)  \(.description)", "clone:   \(.cloneUrl)", "default: \(.defaultBranch // "-")   velikost: \(.size) B   chráněné: \(.protectedBranches|join(","))",
          (if .mirror then "zrcadlo: \(.mirror.url)  [\(.mirror.status)] poslední sync \(.mirror.lastSync // "-")  interval \(.mirror.interval)s\n         webhook: \(.mirror.webhookUrl) (secret \(.mirror.webhookSecret))" else empty end),
          (.pushMirrors[] | "push →   \(.id) \(.url) [\(.status)] \(.lastPush // "")\(if .lastError then " " + .lastError else "" end)"),
          "větve:", (.branches[] | "  \(.name)\t\(.commit[0:8])  \(.date)  \(.subject)"), "tagy:", (.tags[] | "  \(.name)\t\(.commit[0:8])")'
      else rr_api_get_git_repo "$1" "$2"; fi ;;
    create|new) need 2 "$@"; rr_api_create_git_repo "$1" "$(kv_json "name==$2" "description==${3:-}")" | rr_json '{name, cloneUrl, defaultBranch}' ;;
    import)
      need 3 "$@"
      local mirror=true; [ -n "$OPT_no_mirror" ] && mirror=false
      rr_api_create_git_repo "$1" "$(kv_json "name==$2" "importUrl==$3" "mirror=$mirror" "token==$OPT_token" "interval=${OPT_interval:-3600}")" | rr_json '{name, cloneUrl, defaultBranch, mirror: (.mirror|if . then {url, status} else null end)}' ;;
    github)
      need 1 "$@"
      local kind=auto mirror=true
      [ -n "$OPT_org" ] && kind=org; [ -n "$OPT_mine" ] && kind=mine; [ -n "$OPT_user_kind" ] && kind=user
      [ -n "$OPT_no_mirror" ] && mirror=false
      local body
      body=$(kv_json "owner==${2:-}" "token==$OPT_token" "kind=$kind" "mirror=$mirror" "filter==$OPT_filter" "limit=${OPT_limit:-100}" "interval=${OPT_interval:-3600}" "includeForks=${OPT_forks:+true}" "includeArchived=${OPT_archived:+true}")
      [ -n "$OPT_prefix" ] && body="${body%\}},\"prefix\":$(rr_json_str "$OPT_prefix")}"
      if rr_have_jq; then rr_api_github_import "$1" "$body" | jq -r '"nalezeno: \(.found), vybráno: \(.selected)", (.results[] | "  \(.status)\t\(.name)\(if .error then "  " + .error else "" end)")'
      else rr_api_github_import "$1" "$body"; fi ;;
    log|commits)
      need 2 "$@"
      if rr_have_jq; then rr_api_git_commits "$1" "$2" "$(rr_query "ref=${3:-}" "limit=${4:-20}")" | jq -r '.[] | "\(.short)  \(.date[0:10])  \(.author)  \(.subject)"'
      else rr_api_git_commits "$1" "$2" "$(rr_query "ref=${3:-}" "limit=${4:-20}")"; fi ;;
    ls|tree)
      need 2 "$@"
      if rr_have_jq; then rr_api_git_tree "$1" "$2" "$(rr_query "ref=${3:-}" "path=${4:-}")" | jq -r '.entries[] | "\(if .type=="dir" then "📁" else "📄" end) \(.path)\(if .type=="file" then "  (\(.size) B)" else "" end)"'
      else rr_api_git_tree "$1" "$2" "$(rr_query "ref=${3:-}" "path=${4:-}")"; fi ;;
    cat|show-file) need 3 "$@"; rr_api_git_blob "$1" "$2" "$(rr_query "path=$3" "ref=${4:-}")" ;;
    archive)
      need 2 "$@"
      local fmt="${5:-tar.gz}" out="${4:-$(basename "$2")-${3:-HEAD}.${5:-tar.gz}}"
      RR_OUT="$out" rr_api_git_archive "$1" "$2" "$(rr_query "ref=${3:-}" "format=$fmt")" && echo "uloženo: $out" ;;
    sync) need 2 "$@"; rr_api_git_sync "$1" "$2" "$(kv_json "direction=${3:-both}")" | rr_json ;;
    mirror)
      need 3 "$@"
      if [ "$3" = "off" ]; then rr_api_update_git_repo "$1" "$2" '{"mirror":null}' | rr_json '{name, mirror}'
      else rr_api_update_git_repo "$1" "$2" "{\"mirror\":$(kv_json "url==$3" "token==$OPT_token" "interval=${OPT_interval:-3600}" "ttl=${OPT_ttl:-300}" "enabled=true")}" | rr_json '{name, mirror}'; fi ;;
    protect) need 2 "$@"; rr_api_update_git_repo "$1" "$2" "$(kv_json "protectedBranches==${3:-}")" | rr_json '{name, protectedBranches}' ;;
    push-mirror|pm)
      local act="${1:-}"; shift || true
      case "$act" in
        add)
          need 3 "$@"
          local mode=mirror priv=true create=false
          [ -n "$OPT_branches" ] && mode=branches; [ -n "$OPT_public" ] && priv=false; [ -n "$OPT_create" ] && create=true
          rr_api_add_git_push_mirror "$1" "$2" "$(kv_json "url==$3" "token==$OPT_token" "username==$OPT_user" "mode=$mode" "createMissing=$create" "private=$priv")" | rr_json ;;
        rm|delete) need 3 "$@"; rr_api_delete_git_push_mirror "$1" "$2" "$3" | rr_json ;;
        *) rr_die "git push-mirror add|rm" ;;
      esac ;;
    rm|delete) need 2 "$@"; rr_api_delete_git_repo "$1" "$2" | rr_json ;;
    *) rr_die "neznámý příkaz git $sub" ;;
  esac
}

cmd_image() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      need 1 "$@"
      if rr_have_jq; then rr_api_list_images "$1" | jq -r '(["IMAGE","TAGS","SIZE","UPDATED"]|@tsv),(.[]|[.name,.tags,.size,(.updated//"")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_images "$1"; fi ;;
    tags) need 2 "$@"; rr_api_list_image_tags "$1" "$2" | rr_json ;;
    rm|delete) need 3 "$@"; rr_api_delete_image_tag "$1" "$2" "$3" | rr_json ;;
    gc) need 1 "$@"; local u=false; [ "${2:-}" = "--untagged" ] && u=true; rr_api_docker_gc "$1" "{\"untagged\":$u}" | rr_json ;;
    *) rr_die "neznámý příkaz image $sub" ;;
  esac
}

cmd_webhook() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then rr_api_list_webhooks | jq -r '(["ID","NAME","ON","EVENTS","REPOS","FORMAT","URL","LAST"]|@tsv),(.[]|[.id,.name,.enabled,(.events|join(",")),(.repos|join(",")),.format,.url,(if .lastDelivery then "\(.lastDelivery.status) \(.lastDelivery.time)" else "-" end)]|@tsv)' | column -t -s $'\t'
      else rr_api_list_webhooks; fi ;;
    add|create) rr_api_create_webhook "$(kv_json "$@")" | rr_json ;;
    update) need 1 "$@"; local id="$1"; shift; rr_api_update_webhook "$id" "$(kv_json "$@")" | rr_json ;;
    rm|delete) need 1 "$@"; rr_api_delete_webhook "$1" | rr_json ;;
    test) need 1 "$@"; rr_api_test_webhook "$1" | rr_json ;;
    deliveries)
      if rr_have_jq; then rr_api_list_webhook_deliveries "$(rr_query "id=${1:-}" "limit=30")" | jq -r '.[] | "\(.time)  \(.status)  \(if .ok then "OK " else "ERR" end)  \(.hook)  \(.event)  #\(.attempt)  \(.error // "")"'
      else rr_api_list_webhook_deliveries "$(rr_query "id=${1:-}")"; fi ;;
    *) rr_die "neznámý příkaz webhook $sub" ;;
  esac
}

cmd_replication() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then rr_api_list_replications "$(rr_query "status=${1:-}")" | jq -r '(["ID","STATUS","RULE","EVENT","REPO","ITEM","TRY","ERROR"]|@tsv),(.[]|[.id,.status,.ruleName,.event,.repo,.item,.attempts,(.error//"")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_replications "$(rr_query "status=${1:-}")"; fi ;;
    retry) need 1 "$@"; rr_api_retry_replication "$1" | rr_json ;;
    *) rr_die "neznámý příkaz replication $sub" ;;
  esac
}

cmd_task() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      if rr_have_jq; then rr_api_list_tasks | jq -r '(["ID","INTERVAL","LAST RUN","NEXT RUN","ERROR"]|@tsv),(.[]|[.id,"\(.intervalSec)s",(.lastRun//"-"),(.nextRun//"-"),(.lastError//"")]|@tsv)' | column -t -s $'\t'
      else rr_api_list_tasks; fi ;;
    run) need 1 "$@"; rr_api_run_task "$1" | rr_json ;;
    *) rr_die "neznámý příkaz task $sub" ;;
  esac
}

cmd_npmrc() {
  local repo="${1:-}" reg host
  if [ -n "$repo" ]; then reg="${RR_SERVER%/}/r/$repo/"; else reg="${RR_SERVER%/}/"; fi
  host="${reg#http:}"; host="${host#https:}"
  echo "registry=$reg"
  [ -n "$RR_TOKEN" ] && echo "$host:_authToken=$RR_TOKEN"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    version|-v|--version) echo "rr $RR_CLI_VERSION (rr-api.sh $RR_API_VERSION)" ;;
    config) cmd_config "$@" ;;
    login) cmd_login "$@" ;;
    logout) rr_api_logout >/dev/null 2>&1; RR_TOKEN=""; rr_config_save; echo "odhlášeno" ;;
    whoami) rr_api_whoami | rr_json ;;
    status) rr_api_status | rr_json ;;
    repo|repos) cmd_repo "$@" ;;
    pkg|package|packages) cmd_pkg "$@" ;;
    search) cmd_search "$@" ;;
    fs|files) cmd_fs "$@" ;;
    git) cmd_git "$@" ;;
    image|images|docker) cmd_image "$@" ;;
    webhook|webhooks|hook) cmd_webhook "$@" ;;
    events)
      if rr_have_jq; then rr_api_list_events "$(rr_query "limit=${1:-30}")" | jq -r '.events[] | "\(.time)  \(.type)  \(.repo // "-")  \(.user)  \(.data.name // .data.path // "")"'
      else rr_api_list_events "$(rr_query "limit=${1:-30}")"; fi ;;
    replication|replications|repl) cmd_replication "$@" ;;
    task|tasks) cmd_task "$@" ;;
    route|routes) cmd_route "$@" ;;
    cache) cmd_cache "$@" ;;
    user|users) cmd_user "$@" ;;
    token|tokens) cmd_token "$@" ;;
    settings) cmd_settings "$@" ;;
    logs)
      if rr_have_jq; then rr_api_get_logs "$(rr_query "limit=${1:-30}")" | jq -r '.audit[]? | "AUDIT \(.time) \(.user) \(.action) \(.target)"', '.requests[]? | "\(.time) \(.status) \(.method) \(.url) \(.ms)ms \(.user) \(.cache)"'
      else rr_api_get_logs "$(rr_query "limit=${1:-30}")"; fi ;;
    plugins) rr_api_list_plugins | rr_json ;;
    clients) rr_api_list_clients | rr_json ;;
    rebuild-clients) rr_api_rebuild_clients | rr_json ;;
    npmrc) cmd_npmrc "$@" ;;
    api) rr_api_operations | column -t -s $'\t' ;;
    call)
      need 1 "$@"
      local fn="rr_api_${1#rr_api_}"; shift
      declare -F "$fn" >/dev/null || rr_die "neznámá operace $fn (viz rr api)"
      "$fn" "$@" ;;
    *) echo "neznámý příkaz: $cmd" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
