#!/usr/bin/env bash
# rr-gui - RR Registry administration GUI for the terminal (whiptail/dialog). Maintainer: m5ike.
# All operations go through the generated API library lib/rr-api.sh.

_rr_self="${BASH_SOURCE[0]}"
while [ -L "$_rr_self" ]; do
  _rr_dir="$(cd -P "$(dirname "$_rr_self")" && pwd)"
  _rr_self="$(readlink "$_rr_self")"
  [[ "$_rr_self" != /* ]] && _rr_self="$_rr_dir/$_rr_self"
done
RR_HOME="$(cd -P "$(dirname "$_rr_self")/.." && pwd)"
# shellcheck source=../lib/rr-common.sh
. "$RR_HOME/lib/rr-common.sh"
# shellcheck source=../lib/rr-api.sh
. "$RR_HOME/lib/rr-api.sh"
rr_config_load

DLG="${RR_DIALOG:-}"
if [ -z "$DLG" ]; then
  if command -v whiptail >/dev/null 2>&1; then DLG=whiptail
  elif command -v dialog >/dev/null 2>&1; then DLG=dialog
  else rr_die "potřebuji whiptail nebo dialog (apt install whiptail / brew install newt)"; fi
fi
rr_have_jq || rr_die "potřebuji jq (apt install jq / brew install jq)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"; clear' EXIT

H=22; W=90; MH=14

ui() { "$DLG" --title "${UI_TITLE:-RR Registry}" --backtitle "RR Registry GUI $RR_API_VERSION  |  $RR_SERVER  |  m5ike" "$@" 3>&1 1>&2 2>&3; }
msg() { ui --msgbox "$1" "${2:-12}" "${3:-76}"; }
input() { ui --inputbox "$1" 10 76 "${2:-}"; }
secret() { ui --passwordbox "$1" 10 76; }
yesno() { ui --yesno "$1" 10 76; }
menu() { local t="$1"; shift; ui --menu "$t" "$H" "$W" "$MH" "$@"; }
radio() { local t="$1"; shift; ui --radiolist "$t" "$H" "$W" "$MH" "$@"; }
text() {
  printf '%s\n' "$1" >"$TMP/text"
  if [ "$DLG" = whiptail ]; then ui --scrolltext --textbox "$TMP/text" "$H" "$W"; else ui --textbox "$TMP/text" "$H" "$W"; fi
}

# api <rr_api_fn> args... -> stdout = body; on error show message and return 1
api() {
  local out
  if out=$("$@" 2>"$TMP/err"); then printf '%s' "$out"; return 0; fi
  msg "Chyba:\n\n$(cat "$TMP/err")"
  return 1
}

# menu items from JSON: jsonmenu <json> <jq expression returning [tag, label] pairs flattened>
jsonmenu() { printf '%s' "$1" | jq -r "$2"; }

# fills global ITEMS (bash 3.2 compatible - no namerefs/mapfile)
read_items() { ITEMS=(); local line; while IFS= read -r line; do ITEMS+=("$line"); done; }

# ----------------------------------------------------------------- status
screen_status() {
  local s
  s=$(api rr_api_status) || return
  text "$(printf '%s' "$s" | jq -r '"Server:       \(.title) \(.version)  (maintainer \(.maintainer))
Registry URL: \(.registry)
Výchozí repo: \(.defaultRepo)
Uptime:       \(.uptime) s     Node: \(.node)
Repozitáře:   \(.repos)     Balíčky: \(.packages)     Pravidla: \(.routes)
Cache:        \(.cache.entries) položek, \(.cache.bytes) B, hit \(.cache.hits) / miss \(.cache.misses)
Požadavky:    \(.stats.requests)   stažení: \(.stats.downloads)   proxy: \(.stats.proxied)   chyby: \(.stats.errors)"')"
}

# ----------------------------------------------------------------- connection
screen_connection() {
  while true; do
    local who="(nepřihlášen)"
    [ -n "$RR_TOKEN" ] && who=$(rr_api_whoami 2>/dev/null | jq -r '"\(.name) (\(.role))"' 2>/dev/null || echo "token neplatný")
    local c
    c=$(UI_TITLE="Připojení" menu "Server: $RR_SERVER\nUživatel: $who" \
      server "Změnit adresu serveru" \
      login "Přihlásit se jménem a heslem" \
      token "Zadat API token" \
      logout "Odhlásit" \
      back "Zpět") || return
    case "$c" in
      server) local u; u=$(input "URL serveru:" "$RR_SERVER") && { RR_SERVER="$u"; rr_config_save; } ;;
      login)
        local user pass out
        user=$(input "Uživatel:" "${RR_USER:-admin}") || continue
        pass=$(secret "Heslo:") || continue
        out=$(RR_TOKEN="" api rr_api_login "$(rr_json_obj "username==$user" "password==$pass" "tokenName=rr-gui" "ttl=2592000")") || continue
        RR_TOKEN=$(printf '%s' "$out" | jq -r .token); RR_USER="$user"; rr_config_save
        msg "Přihlášen jako $user." ;;
      token) local t; t=$(input "API token:" "") && { RR_TOKEN="$t"; rr_config_save; } ;;
      logout) rr_api_logout >/dev/null 2>&1; RR_TOKEN=""; rr_config_save; msg "Odhlášeno." ;;
      *) return ;;
    esac
  done
}

# ----------------------------------------------------------------- repositories
pick_repo() {
  local json items
  json=$(api rr_api_list_repos) || return 1
  read_items < <(jsonmenu "$json" '.[] | .name, "\(.type)  \(if .default then "[výchozí] " else "" end)\(.description)"')
  [ ${#ITEMS[@]} -gt 0 ] || { msg "Žádné repozitáře."; return 1; }
  UI_TITLE="Repozitáře" menu "${1:-Vyberte repozitář}" "${ITEMS[@]}"
}

screen_repos() {
  while true; do
    local json items c
    json=$(api rr_api_list_repos) || return
    read_items < <(jsonmenu "$json" '.[] | .name, "\(.type)\t\(.packages // "-") bal.  \(if .default then "[výchozí] " else "" end)\(.description)"')
    c=$(UI_TITLE="Repozitáře" menu "Správa repozitářů" "+new" "Vytvořit nový repozitář" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new)
        local name type desc
        name=$(input "Název repozitáře (a-z, 0-9, ._-):") || continue
        type=$(radio "Typ repozitáře" npm "npm / yarn / pnpm / bun balíčky" ON generic "Obecné soubory" OFF docker "Docker / OCI image" OFF git "Git repozitáře" OFF group "Skupina (virtuální)" OFF) || continue
        desc=$(input "Popis:") || continue
        local extra=""
        if [ "$type" = group ]; then
          local mem dep
          mem=$(input "Členové skupiny (npm nebo generic repozitáře, čárkou):" "npm") || continue
          dep=$(input "Publikovat přes skupinu do (deployTo, prázdné = jen čtení):") || continue
          extra=",\"members\":$(rr_json_str "$mem"),\"deployTo\":$(rr_json_str "$dep")"
        fi
        local body; body=$(rr_json_obj "name==$name" "type=$type" "description==$desc"); body="${body%\}}$extra}"
        api rr_api_create_repo "$body" >/dev/null && msg "Repozitář $name vytvořen.\nURL: ${RR_SERVER%/}/r/$name/" ;;
      *) screen_repo "$c" ;;
    esac
  done
}

screen_repo() {
  local repo="$1"
  while true; do
    local info type c
    info=$(api rr_api_get_repo "$repo") || return
    type=$(printf '%s' "$info" | jq -r .type)
    c=$(UI_TITLE="Repozitář $repo" menu "$(printf '%s' "$info" | jq -r '"Typ: \(.type)   Veřejný: \(.public)   Publikace: \(.allowPublish)\nÚložiště: \(.storage.files) souborů, \(.storage.bytes) B"')" \
      info "Detail (JSON)" \
      packages "Balíčky" \
      files "Procházet soubory" \
      desc "Upravit popis" \
      public "Přepnout veřejné čtení" \
      publish "Přepnout povolení publikace" \
      npmrc "Ukázat nastavení npm" \
      git "Git repozitáře (typ git)" \
      advanced "Pokročilé: kvóta, neměnnost, přístup, skupina" \
      policy "Pravidla čištění (retence)" \
      cleanup "Spustit čištění" \
      stats "Statistiky stahování" \
      delete "Smazat repozitář" \
      back "Zpět") || return
    case "$c" in
      info) text "$(printf '%s' "$info" | jq .)" ;;
      packages) if [ "$type" = npm ]; then screen_packages "$repo"; else screen_files "$repo" "/"; fi ;;
      files) screen_files "$repo" "/" ;;
      desc) local d; d=$(input "Popis:" "$(printf '%s' "$info" | jq -r .description)") && api rr_api_update_repo "$repo" "$(rr_json_obj "description==$d")" >/dev/null ;;
      public) api rr_api_update_repo "$repo" "$(printf '%s' "$info" | jq -c '{public: (.public|not)}')" >/dev/null ;;
      publish) api rr_api_update_repo "$repo" "$(printf '%s' "$info" | jq -c '{allowPublish: (.allowPublish|not)}')" >/dev/null ;;
      git) if [ "$type" = git ]; then screen_git "$repo"; else msg "Repozitář $repo není typu git."; fi ;;
      advanced) screen_repo_advanced "$repo" "$info" ;;
      policy) screen_repo_policy "$repo" "$info" ;;
      cleanup)
        text "$(api rr_api_run_cleanup "$repo" '{"dryRun":true}' | jq -r '"Náhled čištění (nic se nesmazalo):", (.actions[] | "  \(.action) \(.target)  \(.reason // "")"), "celkem: \(.actions|length)"')"
        yesno "Provést čištění repozitáře $repo?" && msg "$(api rr_api_run_cleanup "$repo" '{"dryRun":false}' | jq -r '"Hotovo: \(.actions|length) akcí, uvolněno \(.freedBytes) B"')" ;;
      stats) text "$(api rr_api_get_repo_stats "$repo" | jq -r '"Stažení celkem: \(.total)\nPoslední: \(.last // "-")\n\nNejstahovanější:", (.top[] | "  \(.downloads)\t\(.item)"), "\nPosledních 30 dní:", (.days[] | select(.downloads > 0) | "  \(.day)  \(.downloads)")')" ;;
      npmrc) msg "Do ~/.npmrc nebo .npmrc projektu:\n\nregistry=${RR_SERVER%/}/r/$repo/\n${RR_SERVER#http*:}/r/$repo/:_authToken=<token>\n\nnebo: npm install <balíček> --registry ${RR_SERVER%/}/r/$repo/" 16 90 ;;
      delete)
        yesno "Opravdu smazat repozitář $repo?" || continue
        local q=""; yesno "Smazat i všechny soubory na disku?" && q="purge=1"
        api rr_api_delete_repo "$repo" "$q" >/dev/null && { msg "Smazáno."; return; } ;;
      *) return ;;
    esac
  done
}

screen_repo_advanced() {
  local repo="$1" info="$2" c v
  c=$(UI_TITLE="Pokročilé – $repo" menu "$(printf '%s' "$info" | jq -r '"Kvóta: \(.quotaMb // 0) MB\(if .quota then " (využito \(.quota.usedBytes) B)" else "" end)   Neměnný: \(.immutable // false)\nACL: \(.acl // {} | to_entries | map("\(.key)=\(.value)") | join(", "))\(if .members then "\nČlenové: \(.members|join(",")) → deploy \(.deployTo // "-")" else "" end)"')" \
    quota "Kvóta úložiště (MB, 0 = bez limitu)" \
    immutable "Přepnout neměnnost (zákaz mazání/přepisu)" \
    acl "Přístupová práva uživatelů" \
    members "Členové skupiny (typ group)" \
    deploy "Cíl publikace skupiny (deployTo)" \
    autocreate "Git: vytvářet repozitář při prvním push" \
    back "Zpět") || return
  case "$c" in
    quota) v=$(input "Kvóta v MB:" "$(printf '%s' "$info" | jq -r '.quotaMb // 0')") && api rr_api_update_repo "$repo" "$(rr_json_obj "quotaMb=$v")" >/dev/null ;;
    immutable) api rr_api_update_repo "$repo" "$(printf '%s' "$info" | jq -c '{immutable: ((.immutable // false)|not)}')" >/dev/null ;;
    acl) v=$(input "ACL ve tvaru uživatel:úroveň,… (none|read|publish; prázdné = zrušit):" "$(printf '%s' "$info" | jq -r '.acl // {} | to_entries | map("\(.key):\(.value)") | join(",")')") && api rr_api_update_repo "$repo" "$(rr_json_obj "acl==$v")" >/dev/null ;;
    members) v=$(input "Členové (názvy repozitářů oddělené čárkou):" "$(printf '%s' "$info" | jq -r '(.members // []) | join(",")')") && api rr_api_update_repo "$repo" "$(rr_json_obj "members==$v")" >/dev/null ;;
    deploy) v=$(input "deployTo (člen, kam se publikuje; prázdné = jen čtení):" "$(printf '%s' "$info" | jq -r '.deployTo // ""')") && api rr_api_update_repo "$repo" "$(rr_json_obj "deployTo==$v")" >/dev/null ;;
    autocreate) api rr_api_update_repo "$repo" "$(printf '%s' "$info" | jq -c '{autoCreate: ((.autoCreate // false)|not)}')" >/dev/null ;;
  esac
}

screen_repo_policy() {
  local repo="$1" info="$2" en mv ma pre pat ih
  en=false; yesno "Zapnout automatické čištění repozitáře $repo?" && en=true
  mv=$(input "Ponechat nejnovějších N verzí / tagů / souborů v adresáři (0 = bez limitu):" "$(printf '%s' "$info" | jq -r '.cleanup.maxVersions // 0')") || return
  ma=$(input "Mazat starší než N dní (0 = bez limitu):" "$(printf '%s' "$info" | jq -r '.cleanup.maxAgeDays // 0')") || return
  pre=false; yesno "Čistit jen pre-release verze (npm)?" && pre=true
  pat=$(input "Glob omezení cest (generic, prázdné = vše):" "$(printf '%s' "$info" | jq -r '.cleanup.pattern // ""')") || return
  ih=$(input "Interval spouštění (hodiny):" "$(printf '%s' "$info" | jq -r '.cleanup.intervalHours // 24')") || return
  api rr_api_update_repo "$repo" "{\"cleanup\":$(rr_json_obj "enabled=$en" "maxVersions=${mv:-0}" "maxAgeDays=${ma:-0}" "prereleaseOnly=$pre" "pattern==$pat" "intervalHours=${ih:-24}")}" >/dev/null && msg "Pravidla uložena."
}

# ----------------------------------------------------------------- git
pick_git_repo() {
  local json
  json=$(api rr_api_list_repos) || return 1
  read_items < <(jsonmenu "$json" '.[] | select(.type=="git") | .name, "\(.gitRepos // 0) repozitářů  \(.description)"')
  [ ${#ITEMS[@]} -gt 0 ] || { msg "Žádný repozitář typu git."; return 1; }
  UI_TITLE="Git" menu "Vyberte git repozitář" "${ITEMS[@]}"
}

screen_git() {
  local repo="$1"
  while true; do
    local json c
    json=$(api rr_api_list_git_repos "$repo") || return
    read_items < <(jsonmenu "$json" '.[] | .name, "\(if .mirror then "⇣ zrcadlo [\(.mirror.status)] " else "" end)\(if .pushMirrors > 0 then "⇡\(.pushMirrors) " else "" end)\(.description)"')
    c=$(UI_TITLE="Git – $repo" menu "Git repozitáře (git clone ${RR_SERVER%/}/r/$repo/<název>.git)" \
      "+new" "Nový prázdný repozitář" "+import" "Import / zrcadlo z URL" "+github" "Hromadný import z GitHubu" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new)
        local n d; n=$(input "Název (může obsahovat /, např. tym/projekt):") || continue; d=$(input "Popis:") || continue
        api rr_api_create_git_repo "$repo" "$(rr_json_obj "name==$n" "description==$d")" >/dev/null && msg "Vytvořeno.\n\ngit clone ${RR_SERVER%/}/r/$repo/$n.git" 12 90 ;;
      +import)
        local n u t mi=true iv
        u=$(input "URL zdrojového repozitáře (https://github.com/owner/repo.git):") || continue
        n=$(input "Název v registru:" "$(printf '%s' "$u" | sed -E 's#^https?://[^/]+/##; s#\.git$##')") || continue
        t=$(secret "Token (prázdné pro veřejné repozitáře):") || continue
        yesno "Udržovat jako zrcadlo (pravidelná synchronizace)?" || mi=false
        iv=$(input "Interval synchronizace (s):" "3600") || continue
        msg "$(api rr_api_create_git_repo "$repo" "$(rr_json_obj "name==$n" "importUrl==$u" "token==$t" "mirror=$mi" "interval=${iv:-3600}")" | jq -r '"Importováno: \(.name)\nvětví: \(.branches|length), tagů: \(.tags|length)"')" ;;
      +github)
        local o t f l mi=true r
        o=$(input "GitHub uživatel nebo organizace (prázdné = moje repozitáře, vyžaduje token):") || continue
        t=$(secret "GitHub token (nutný pro privátní repozitáře):") || continue
        f=$(input "Filtr názvů (glob, prázdné = vše):") || continue
        l=$(input "Maximální počet:" "50") || continue
        yesno "Udržovat jako zrcadla?" || mi=false
        r=$(api rr_api_github_import "$repo" "$(rr_json_obj "owner==$o" "token==$t" "filter==$f" "limit=${l:-50}" "mirror=$mi" "kind=$([ -z "$o" ] && echo mine || echo auto)")") || continue
        text "$(printf '%s' "$r" | jq -r '"Nalezeno: \(.found), vybráno: \(.selected)\n", (.results[] | "\(.status)\t\(.name)\(if .error then "  " + .error else "" end)")')" ;;
      *) screen_git_repo "$repo" "$c" ;;
    esac
  done
}

screen_git_repo() {
  local repo="$1" name="$2"
  while true; do
    local info c
    info=$(api rr_api_get_git_repo "$repo" "$name") || return
    c=$(UI_TITLE="$name" menu "$(printf '%s' "$info" | jq -r '"\(.cloneUrl)\nVětev: \(.defaultBranch // "-")  větví: \(.branches|length)  tagů: \(.tags|length)\(if .mirror then "\nZrcadlo: \(.mirror.url) [\(.mirror.status)]" else "" end)"')" \
      info "Větve, tagy, zrcadla" log "Historie commitů" browse "Procházet soubory" \
      sync "Synchronizovat zrcadla" mirror "Nastavit / zrušit pull zrcadlo" pushmirror "Přidat push zrcadlo" \
      rmpush "Odebrat push zrcadlo" protect "Chráněné větve" branch "Výchozí větev" desc "Popis" \
      archive "Stáhnout archiv" delete "Smazat repozitář" back "Zpět") || return
    case "$c" in
      info) text "$(printf '%s' "$info" | jq -r '"Clone: \(.cloneUrl)\nPopis: \(.description)\nVelikost: \(.size) B\nChráněné větve: \(.protectedBranches|join(", "))",
         (if .mirror then "\nPull zrcadlo: \(.mirror.url)\n  stav \(.mirror.status), poslední sync \(.mirror.lastSync // "-"), interval \(.mirror.interval) s\n  chyba: \(.mirror.lastError // "-")\n  webhook: \(.mirror.webhookUrl)\n  secret: \(.mirror.webhookSecret)" else empty end),
         (if (.pushMirrors|length) > 0 then "\nPush zrcadla:", (.pushMirrors[] | "  \(.id) \(.url) [\(.status)] \(.lastPush // "")  \(.lastError // "")") else empty end),
         "\nVětve:", (.branches[] | "  \(.name)  \(.commit[0:8])  \(.date)  \(.subject)"), "\nTagy:", (.tags[] | "  \(.name)  \(.commit[0:8])")')" ;;
      log) text "$(api rr_api_git_commits "$repo" "$name" "limit=100" | jq -r '.[] | "\(.short)  \(.date[0:16])  \(.author)\n         \(.subject)"')" ;;
      browse) screen_git_tree "$repo" "$name" "" "" ;;
      sync) local d; d=$(radio "Směr" both "pull i push" ON pull "stáhnout ze zdroje" OFF push "odeslat do push zrcadel" OFF) && text "$(api rr_api_git_sync "$repo" "$name" "$(rr_json_obj "direction=$d")" | jq .)" ;;
      mirror)
        local u t iv
        u=$(input "URL zdroje (prázdné = zrušit zrcadlo):" "$(printf '%s' "$info" | jq -r '.mirror.url // ""')") || continue
        if [ -z "$u" ]; then api rr_api_update_git_repo "$repo" "$name" '{"mirror":null}' >/dev/null; continue; fi
        t=$(secret "Token (prázdné = beze změny/veřejné):") || continue
        iv=$(input "Interval synchronizace (s):" "$(printf '%s' "$info" | jq -r '.mirror.interval // 3600')") || continue
        local body; body=$(rr_json_obj "url==$u" "interval=${iv:-3600}" "enabled=true")
        [ -n "$t" ] && body=$(printf '%s' "$body" | jq -c --arg t "$t" '. + {token: $t}')
        api rr_api_update_git_repo "$repo" "$name" "{\"mirror\":$body}" >/dev/null && msg "Zrcadlo nastaveno. Spusťte synchronizaci." ;;
      pushmirror)
        local u t cr=false
        u=$(input "Cílová URL (např. https://github.com/firma/projekt.git):") || continue
        t=$(secret "Token pro cíl:") || continue
        yesno "Vytvořit repozitář na GitHubu, pokud neexistuje?" && cr=true
        api rr_api_add_git_push_mirror "$repo" "$name" "$(rr_json_obj "url==$u" "token==$t" "createMissing=$cr")" >/dev/null && msg "Push zrcadlo přidáno – odešle se po každém push nebo synchronizaci." ;;
      rmpush)
        read_items < <(printf '%s' "$info" | jq -r '.pushMirrors[] | .id, .url')
        [ ${#ITEMS[@]} -gt 0 ] || { msg "Žádná push zrcadla."; continue; }
        local id; id=$(menu "Odebrat push zrcadlo" "${ITEMS[@]}") && api rr_api_delete_git_push_mirror "$repo" "$name" "$id" >/dev/null ;;
      protect) local v; v=$(input "Chráněné větve (čárkou; zakazuje force-push a smazání):" "$(printf '%s' "$info" | jq -r '.protectedBranches|join(",")')") && api rr_api_update_git_repo "$repo" "$name" "$(rr_json_obj "protectedBranches==$v")" >/dev/null ;;
      branch) local v; v=$(input "Výchozí větev:" "$(printf '%s' "$info" | jq -r '.defaultBranch // "main"')") && api rr_api_update_git_repo "$repo" "$name" "$(rr_json_obj "defaultBranch==$v")" >/dev/null ;;
      desc) local v; v=$(input "Popis:" "$(printf '%s' "$info" | jq -r '.description')") && api rr_api_update_git_repo "$repo" "$name" "$(rr_json_obj "description==$v")" >/dev/null ;;
      archive)
        local ref o; ref=$(input "Větev / tag:" "$(printf '%s' "$info" | jq -r '.defaultBranch // "HEAD"')") || continue
        o=$(input "Uložit do:" "$PWD/${name##*/}-$ref.tar.gz") || continue
        RR_OUT="$o" rr_api_git_archive "$repo" "$name" "$(rr_query "ref=$ref")" 2>"$TMP/err" && msg "Uloženo: $o" || msg "Chyba: $(cat "$TMP/err")" ;;
      delete) yesno "Smazat git repozitář $name?" && api rr_api_delete_git_repo "$repo" "$name" >/dev/null && return ;;
      *) return ;;
    esac
  done
}

screen_git_tree() {
  local repo="$1" name="$2" ref="$3" path="$4"
  while true; do
    local json c
    json=$(api rr_api_git_tree "$repo" "$name" "$(rr_query "ref=$ref" "path=$path")") || return
    read_items < <(jsonmenu "$json" '.entries[] | (.name + (if .type=="dir" then "/" else "" end)), (if .type=="dir" then "adresář" else "\(.size) B" end)')
    c=$(UI_TITLE="$name:${ref:-HEAD}" menu "/$path" ".." "O úroveň výš" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      ..) [ -z "$path" ] && return; path="$(dirname "$path")"; [ "$path" = "." ] && path="" ;;
      */) path="${path:+$path/}${c%/}" ;;
      *) text "$(rr_api_git_blob "$repo" "$name" "$(rr_query "ref=$ref" "path=${path:+$path/}$c")" | head -c 200000)" ;;
    esac
  done
}

# ----------------------------------------------------------------- webhooks, replication, tasks
screen_webhooks() {
  while true; do
    local json c
    json=$(api rr_api_list_webhooks) || return
    read_items < <(jsonmenu "$json" '.[] | .id, "\(if .enabled then "●" else "○" end) \(.name)  [\(.events|join(","))] → \(.url)  \(if .lastDelivery then "(\(.lastDelivery.status))" else "" end)"')
    c=$(UI_TITLE="Webhooky" menu "Notifikace o událostech registru (HMAC podpis X-RR-Signature-256)" "+new" "Nový webhook" "+log" "Historie doručení" "+events" "Poslední události" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new)
        local n u e r f sec
        n=$(input "Název:") || continue
        u=$(input "URL (http/https):") || continue
        e=$(input "Události (čárkou: *, npm.*, git.push, file.upload, docker.push, repo.*, replication.failed …):" "*") || continue
        r=$(input "Repozitáře (čárkou, * = všechny):" "*") || continue
        f=$(radio "Formát" json "JSON (pro aplikace)" ON slack "Slack / Mattermost" OFF discord "Discord" OFF) || continue
        sec=$(input "Tajný klíč pro podpis (volitelné):") || continue
        api rr_api_create_webhook "$(rr_json_obj "name==$n" "url==$u" "events==$e" "repos==$r" "format=$f" "secret==$sec")" >/dev/null && msg "Webhook vytvořen." ;;
      +log) text "$(api rr_api_list_webhook_deliveries "limit=100" | jq -r '.[] | "\(.time[0:19]) \(.status) \(if .ok then "OK " else "ERR" end) \(.hook) \(.event) #\(.attempt) \(.error // "")"')" ;;
      +events) text "$(api rr_api_list_events "limit=100" | jq -r '.events[] | "\(.time[0:19]) \(.type) \(.repo // "-") \(.user) \(.data.name // .data.path // "")"')" ;;
      *)
        local a; a=$(menu "Webhook $c" test "Odeslat test (ping)" toggle "Zapnout / vypnout" log "Doručení" delete "Smazat") || continue
        case "$a" in
          test) text "$(api rr_api_test_webhook "$c" | jq .)" ;;
          toggle) api rr_api_update_webhook "$c" "$(printf '%s' "$json" | jq -c --arg id "$c" '.[] | select(.id==$id) | {enabled: (.enabled|not)}')" >/dev/null ;;
          log) text "$(api rr_api_list_webhook_deliveries "$(rr_query "id=$c")" | jq -r '.[] | "\(.time[0:19]) \(.status) \(.event) #\(.attempt) \(.error // .response // "")"')" ;;
          delete) yesno "Smazat webhook?" && api rr_api_delete_webhook "$c" >/dev/null ;;
        esac ;;
    esac
  done
}

screen_jobs() {
  while true; do
    local c
    c=$(UI_TITLE="Replikace a úlohy" menu "Replikace (pravidla when=push) a naplánované úlohy" \
      repl "Fronta replikací" retry "Znovu spustit replikaci" tasks "Naplánované úlohy" run "Spustit úlohu" back "Zpět") || return
    case "$c" in
      repl) text "$(api rr_api_list_replications "limit=200" | jq -r '.[] | "\(.created[0:19]) \(.status)\t\(.ruleName) \(.event) \(.repo)/\(.item) try \(.attempts) \(.error // "")"')" ;;
      retry)
        read_items < <(api rr_api_list_replications "status=error" | jq -r '.[] | .id, "\(.ruleName) \(.repo)/\(.item) \(.error // "")"')
        [ ${#ITEMS[@]} -gt 0 ] || { msg "Žádné neúspěšné replikace."; continue; }
        local id; id=$(menu "Neúspěšné replikace" "${ITEMS[@]}") && api rr_api_retry_replication "$id" >/dev/null && msg "Zařazeno znovu." ;;
      tasks) text "$(api rr_api_list_tasks | jq -r '.[] | "\(.id)  (\(.name))\n  interval \(.intervalSec)s, poslední \(.lastRun // "-"), další \(.nextRun // "-")\n  \(.lastError // (.lastResult|tostring))\n"')" ;;
      run)
        read_items < <(api rr_api_list_tasks | jq -r '.[] | .id, .name')
        local id; id=$(menu "Spustit úlohu" "${ITEMS[@]}") && text "$(api rr_api_run_task "$id" | jq .)" ;;
      *) return ;;
    esac
  done
}

# ----------------------------------------------------------------- packages
screen_packages() {
  local repo="$1" filter=""
  while true; do
    local json items c
    json=$(api rr_api_list_packages "$repo" "$(rr_query "q=$filter")") || return
    read_items < <(jsonmenu "$json" '.[] | .name, "\(.version)  (\(.versions) verzí)  \(.description[0:50])"')
    c=$(UI_TITLE="Balíčky – $repo" menu "Filtr: ${filter:-žádný}   Počet: $(printf '%s' "$json" | jq length)" \
      "+upload" "Publikovat .tgz soubor" "+filter" "Filtrovat" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +filter) filter=$(input "Filtr názvu/popisu:" "$filter") ;;
      +upload)
        local f tag
        f=$(input "Cesta k .tgz souboru (npm pack):" "$PWD/") || continue
        tag=$(input "dist-tag:" "latest") || continue
        local r; r=$(api rr_api_upload_package "$repo" "$f" "$(rr_query "tag=$tag")") && msg "Publikováno: $(printf '%s' "$r" | jq -r '"\(.name)@\(.version)"')" ;;
      *) screen_package "$repo" "$c" ;;
    esac
  done
}

screen_package() {
  local repo="$1" pkg="$2"
  while true; do
    local doc c
    doc=$(api rr_api_get_package "$repo" "$pkg") || return
    c=$(UI_TITLE="$pkg" menu "$(printf '%s' "$doc" | jq -r '"\(.description // "")\nTagy: \(."dist-tags" | to_entries | map("\(.key)=\(.value)") | join(", "))"')" \
      info "Detail a verze" readme "README" tag "Nastavit dist-tag" untag "Smazat dist-tag" \
      deprecate "Označit verzi jako zastaralou" download "Stáhnout tarball" \
      delver "Smazat verzi" delete "Smazat celý balíček" back "Zpět") || return
    case "$c" in
      info) text "$(printf '%s' "$doc" | jq -r '"Název: \(.name)\nPopis: \(.description)\nSprávci: \(.maintainers|map(.name)|join(", "))\nVytvořeno: \(.time.created)\nZměněno: \(.time.modified)\n\nVerze:", (.versions | to_entries[] | "  \(.key)\t\(.value.dist.size // "") B\t\(.value.deprecated // "")\t\(.value.dist.tarball)")')" ;;
      readme) text "$(printf '%s' "$doc" | jq -r '.readme // "(bez README)"')" ;;
      tag)
        local t v; t=$(input "Tag:" "beta") || continue; v=$(pick_version "$doc") || continue
        api rr_api_set_dist_tag "$repo" "$pkg" "$t" "$(rr_json_obj "version==$v")" >/dev/null ;;
      untag) local t; t=$(input "Tag ke smazání:") && api rr_api_delete_dist_tag "$repo" "$pkg" "$t" >/dev/null ;;
      deprecate)
        local v m; v=$(pick_version "$doc") || continue; m=$(input "Zpráva (prázdná = zrušit):") || continue
        api rr_api_deprecate_version "$repo" "$pkg" "$v" "$(rr_json_obj "message==$m")" >/dev/null ;;
      download)
        local v o; v=$(pick_version "$doc") || continue
        o=$(input "Uložit do:" "$PWD/${pkg##*/}-$v.tgz") || continue
        RR_OUT="$o" rr_api_download_tarball "$repo" "$pkg" "$v" 2>"$TMP/err" && msg "Uloženo: $o" || msg "Chyba: $(cat "$TMP/err")" ;;
      delver)
        local v; v=$(pick_version "$doc") || continue
        yesno "Smazat $pkg@$v?" && api rr_api_delete_version "$repo" "$pkg" "$v" >/dev/null ;;
      delete) yesno "Smazat balíček $pkg se všemi verzemi?" && api rr_api_delete_package "$repo" "$pkg" >/dev/null && return ;;
      *) return ;;
    esac
  done
}

pick_version() {
  local items
  read_items < <(jsonmenu "$1" '.versions | keys[] | ., "verze"')
  menu "Vyberte verzi" "${ITEMS[@]}"
}

# ----------------------------------------------------------------- files
screen_files() {
  local repo="$1" path="${2:-/}"
  while true; do
    local json items c
    json=$(api rr_api_tree "$repo" "$(rr_query "path=$path" "depth=1")") || return
    read_items < <(jsonmenu "$json" '.children // [] | .[] | .name + (if .type=="dir" then "/" else "" end), (if .type=="dir" then "adresář" else "\(.size) B  \(.modified[0:19])" end)')
    c=$(UI_TITLE="Soubory – $repo" menu "Cesta: $path" ".." "O úroveň výš" "+upload" "Nahrát soubor sem" "+mkdir" "Nový adresář" "${ITEMS[@]}" "back" "Zpět") || return
    local base="${path%/}"
    case "$c" in
      back) return ;;
      ..) [ "$path" = "/" ] && return; path="$(dirname "$path")" ;;
      +upload)
        local f n; f=$(input "Lokální soubor:" "$PWD/") || continue
        n=$(input "Název v repozitáři:" "$(basename "$f")") || continue
        api rr_api_write_file "$repo" "$f" "$(rr_query "path=$base/$n")" >/dev/null && msg "Nahráno." ;;
      +mkdir) local n; n=$(input "Název adresáře:") && api rr_api_mkdir "$repo" "$(rr_query "path=$base/$n")" >/dev/null ;;
      */) path="$base/${c%/}" ;;
      *) screen_file "$repo" "$base/$c" ;;
    esac
  done
}

screen_file() {
  local repo="$1" file="$2" c
  c=$(UI_TITLE="$file" menu "Soubor $file" view "Zobrazit obsah" info "Informace" download "Stáhnout" delete "Smazat" back "Zpět") || return
  case "$c" in
    view)
      local size; size=$(rr_api_stat "$repo" "$(rr_query "path=$file")" | jq -r .size)
      if [ "${size:-0}" -gt 200000 ]; then msg "Soubor je příliš velký ($size B)."; return; fi
      if [[ "$file" == *.tgz ]]; then
        RR_OUT="$TMP/f.tgz" rr_api_read_file "$repo" "$(rr_query "path=$file")" && text "$(tar -tzvf "$TMP/f.tgz" 2>&1)"
      else
        text "$(rr_api_read_file "$repo" "$(rr_query "path=$file")" | head -c 200000)"
      fi ;;
    info) text "$(api rr_api_stat "$repo" "$(rr_query "path=$file")" | jq .)" ;;
    download) local o; o=$(input "Uložit do:" "$PWD/$(basename "$file")") && RR_OUT="$o" rr_api_read_file "$repo" "$(rr_query "path=$file")" && msg "Uloženo: $o" ;;
    delete) yesno "Smazat $file?" && api rr_api_delete_file "$repo" "$(rr_query "path=$file")" >/dev/null ;;
  esac
}

# ----------------------------------------------------------------- docker
screen_images() {
  local json repo
  json=$(api rr_api_list_repos) || return
  read_items < <(jsonmenu "$json" '.[] | select(.type=="docker") | .name, "\(.images // 0) image  \(.description)"')
  [ ${#ITEMS[@]} -gt 0 ] || { msg "Žádný docker repozitář."; return; }
  repo=$(menu "Docker repozitář" "${ITEMS[@]}") || return
  while true; do
    local c
    json=$(api rr_api_list_images "$repo") || return
    read_items < <(jsonmenu "$json" '.[] | .name, "\(.tags) tagů  \(.size) B"')
    c=$(UI_TITLE="Docker – $repo" menu "docker pull ${RR_SERVER#http*://}/<image>:<tag>" "+gc" "Garbage collection" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +gc) local u=false; yesno "Smazat i manifesty bez tagu?" && u=true; text "$(api rr_api_docker_gc "$repo" "{\"untagged\":$u}" | jq .)" ;;
      *)
        read_items < <(api rr_api_list_image_tags "$repo" "$c" | jq -r '.[] | .tag, "\(.digest[0:19])  \(.size) B  \(.created // "")"')
        local t; t=$(menu "Tagy $c (vyberte ke smazání)" "${ITEMS[@]}") || continue
        yesno "Smazat $c:$t?" && api rr_api_delete_image_tag "$repo" "$c" "$t" >/dev/null ;;
    esac
  done
}

# ----------------------------------------------------------------- search
screen_search() {
  local q json items c
  q=$(input "Hledat balíček (název, popis, keywords:x, scope:x):") || return
  json=$(api rr_api_search "$(rr_query "q=$q")") || return
  read_items < <(jsonmenu "$json" '.objects[] | "\(.repository):\(.package.name)", "\(.package.version)  \(.package.description[0:50])"')
  [ ${#ITEMS[@]} -gt 0 ] || { msg "Nic nenalezeno."; return; }
  c=$(UI_TITLE="Výsledky" menu "Nalezeno: $(printf '%s' "$json" | jq .total)" "${ITEMS[@]}") || return
  screen_package "${c%%:*}" "${c#*:}"
}

# ----------------------------------------------------------------- routes
screen_routes() {
  while true; do
    local json items c
    json=$(api rr_api_list_routes) || return
    read_items < <(jsonmenu "$json" '.[] | .id, "\(if .enabled then "●" else "○" end) \(.name)  [\(.when)] \(.matchType):\(if .pattern=="" then "*" else .pattern end)\(if .key!="" then " key=\(.key)" else "" end) → \(.target)"')
    c=$(UI_TITLE="Směrování" menu "Pravidla routing pluginu (pořadí dle priority)" "+new" "Nové pravidlo" "+test" "Otestovat cestu" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new) route_wizard ;;
      +test)
        local p r k
        p=$(input "Cesta (např. /@corp/utils nebo /lodash):" "/") || continue
        r=$(input "Repozitář (prázdné = výchozí):") || continue
        k=$(input "Klíč (prázdné = žádný):") || continue
        text "$(api rr_api_test_route "$(rr_json_obj "path==$p" "repo==$r" "key==$k")" | jq -r '"Požadavek: \(.request)\n\nVždy (always):     \(.always.name // "-")  \(.always.target // "")\nPři nenalezení:    \(.notfound.name // "-")  \(.notfound.target // "")\n\nPravidla:", (.rules[] | "  \(if .matched then "✔" else "✘" end) \(.name) [\(.when)] → \(.target)")')" ;;
      *) screen_route "$c" ;;
    esac
  done
}

route_wizard() {
  local name target when matchOn matchType pattern repo key ttl prio
  name=$(input "Název pravidla:") || return
  target=$(input "Cílový registr (URL):" "https://registry.npmjs.org") || return
  when=$(radio "Kdy přesměrovat" notfound "pokud balíček/soubor není lokálně" ON always "vždy (před lokálním repozitářem)" OFF) || return
  matchOn=$(radio "Porovnávat s" package "cestou balíčku (/@scope/name)" ON path "cestou v repozitáři" OFF url "celou URL" OFF) || return
  matchType=$(radio "Typ masky" prefix "začíná na" ON glob "glob (* ** ?)" OFF regex "regulární výraz" OFF contains "obsahuje" OFF exact "přesná shoda" OFF) || return
  pattern=$(input "Maska (prázdné = vše):" "") || return
  repo=$(input "Repozitář (* = všechny):" "*") || return
  key=$(input "Směrovací klíč (prázdné = bez klíče; použití /~klic/ nebo hlavička X-RR-Key):" "") || return
  ttl=$(input "Platnost cache v sekundách (prázdné = výchozí):" "") || return
  prio=$(input "Priorita (nižší = dříve):" "100") || return
  local body
  body=$(rr_json_obj "name==$name" "target==$target" "when=$when" "matchOn=$matchOn" "matchType=$matchType" "pattern==$pattern" "repo==$repo" "key==$key" "priority=${prio:-100}")
  [ -n "$ttl" ] && body=$(printf '%s' "$body" | jq -c --argjson t "$ttl" '. + {cacheTtl: $t}')
  api rr_api_create_route "$body" >/dev/null && msg "Pravidlo $name vytvořeno."
}

screen_route() {
  local id="$1"
  while true; do
    local r c
    r=$(api rr_api_get_route "$id") || return
    c=$(UI_TITLE="Pravidlo $(printf '%s' "$r" | jq -r .name)" menu "$(printf '%s' "$r" | jq -r '"\(.when) | \(.matchOn)/\(.matchType): \(.pattern) | repo \(.repo) → \(.target)"')" \
      info "Detail (JSON)" toggle "Zapnout / vypnout" edit "Upravit pole" delete "Smazat" back "Zpět") || return
    case "$c" in
      info) text "$(printf '%s' "$r" | jq .)" ;;
      toggle) api rr_api_update_route "$id" "$(printf '%s' "$r" | jq -c '{enabled: (.enabled|not)}')" >/dev/null ;;
      edit)
        local items f v
        read_items < <(printf '%s' "$r" | jq -r 'to_entries[] | select(.key!="id" and .key!="headers" and .key!="header") | .key, (.value|tostring)')
        f=$(menu "Pole k úpravě" "${ITEMS[@]}") || continue
        v=$(input "Nová hodnota pro $f:" "$(printf '%s' "$r" | jq -r --arg f "$f" '.[$f]|if type=="array" then join(",") else tostring end')") || continue
        api rr_api_update_route "$id" "$(rr_json_obj "$f=$v")" >/dev/null ;;
      delete) yesno "Smazat pravidlo?" && api rr_api_delete_route "$id" >/dev/null && return ;;
      *) return ;;
    esac
  done
}

# ----------------------------------------------------------------- cache
screen_cache() {
  while true; do
    local s c
    s=$(api rr_api_cache_stats) || return
    c=$(UI_TITLE="Cache" menu "$(printf '%s' "$s" | jq -r '"Položek: \(.entries) (expirovaných \(.expired)), velikost \(.bytes) B\nHit \(.hits) / miss \(.misses) / stale \(.stale) / chyby \(.errors)"')" \
      list "Zobrazit položky" expired "Smazat expirované" filter "Smazat dle filtru URL" all "Smazat vše" back "Zpět") || return
    case "$c" in
      list) text "$(api rr_api_list_cache "limit=300" | jq -r '.entries[] | "\(if .expired then "EXP" else "OK " end) \(.size)\t\(.url)"')" ;;
      expired) msg "Smazáno: $(api rr_api_purge_cache "expired=1" | jq .removed)" ;;
      filter) local q; q=$(input "Část URL:") && msg "Smazáno: $(api rr_api_purge_cache "$(rr_query "q=$q")" | jq .removed)" ;;
      all) yesno "Smazat celou cache?" && msg "Smazáno: $(api rr_api_purge_cache | jq .removed)" ;;
      *) return ;;
    esac
  done
}

# ----------------------------------------------------------------- users & tokens
screen_users() {
  while true; do
    local json items c
    json=$(api rr_api_list_users) || return
    read_items < <(jsonmenu "$json" '.[] | .name, "\(.role)  \(.email // "")\(if .builtin then "  (vestavěný)" else "" end)"')
    c=$(UI_TITLE="Uživatelé" menu "Uživatelé registru" "+new" "Nový uživatel" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new)
        local n p r e
        n=$(input "Jméno:") || continue; p=$(secret "Heslo:") || continue
        r=$(radio "Role" publisher "čtení + publikace" ON reader "jen čtení" OFF admin "správce" OFF) || continue
        e=$(input "E-mail:") || continue
        api rr_api_create_user "$(rr_json_obj "name==$n" "password==$p" "role=$r" "email==$e")" >/dev/null && msg "Uživatel $n vytvořen." ;;
      *)
        local a; a=$(menu "Uživatel $c" passwd "Změnit heslo" role "Změnit roli" token "Vytvořit token" delete "Smazat") || continue
        case "$a" in
          passwd) local p; p=$(secret "Nové heslo:") && api rr_api_update_user "$c" "$(rr_json_obj "password==$p")" >/dev/null && msg "Heslo změněno." ;;
          role) local r; r=$(radio "Role" publisher "" ON reader "" OFF admin "" OFF) && api rr_api_update_user "$c" "$(rr_json_obj "role=$r")" >/dev/null ;;
          token) local t; t=$(api rr_api_create_token "$(rr_json_obj "name=rr-gui" "user==$c")") && msg "Token pro $c (uložte si ho, znovu se nezobrazí):\n\n$(printf '%s' "$t" | jq -r .token)" 14 90 ;;
          delete) yesno "Smazat uživatele $c?" && api rr_api_delete_user "$c" >/dev/null ;;
        esac ;;
    esac
  done
}

screen_tokens() {
  while true; do
    local json items c
    json=$(api rr_api_list_tokens) || return
    read_items < <(jsonmenu "$json" '.[] | .id, "\(.user)  \(.name)  \(.preview)\(if .readonly then " RO" else "" end)  \(.expires // "bez expirace")"')
    c=$(UI_TITLE="Tokeny" menu "API tokeny" "+new" "Nový token" "${ITEMS[@]}" "back" "Zpět") || return
    case "$c" in
      back) return ;;
      +new)
        local n ro=false t
        n=$(input "Název tokenu:" "ci") || continue
        yesno "Pouze pro čtení?" && ro=true
        t=$(api rr_api_create_token "$(rr_json_obj "name==$n" "readonly=$ro")") && msg "Nový token (uložte si ho, znovu se nezobrazí):\n\n$(printf '%s' "$t" | jq -r .token)" 14 90 ;;
      *) yesno "Zneplatnit token $c?" && api rr_api_revoke_token "$c" >/dev/null ;;
    esac
  done
}

# ----------------------------------------------------------------- settings & logs
screen_settings() {
  while true; do
    local json items c v
    json=$(api rr_api_get_settings) || return
    read_items < <(jsonmenu "$json" 'to_entries[] | .key, (.value|if type=="array" then join(",") else tostring end)')
    c=$(UI_TITLE="Nastavení" menu "Nastavení serveru (uloženo v data/config/settings.json)" "${ITEMS[@]}" "back" "Zpět") || return
    [ "$c" = back ] && return
    v=$(input "Nová hodnota $c:" "$(printf '%s' "$json" | jq -r --arg k "$c" '.[$k]|if type=="array" then join(",") else tostring end')") || continue
    case "$c" in
      title|motd|defaultRepo|clientsRepo|cors) api rr_api_update_settings "$(rr_json_obj "$c==$v")" >/dev/null ;;
      *) api rr_api_update_settings "$(rr_json_obj "$c=$v")" >/dev/null ;;
    esac
  done
}

screen_logs() {
  text "$(api rr_api_get_logs "limit=200" | jq -r '"== AUDIT ==", (.audit[] | "\(.time[0:19]) \(.user) \(.action) \(.target)"), "", "== POŽADAVKY ==", (.requests[] | "\(.time[11:19]) \(.status) \(.method) \(.url) \(.ms)ms \(.user) \(.cache)")')"
}

screen_clients() {
  local json
  json=$(api rr_api_list_clients) || return
  text "$(printf '%s' "$json" | jq -r '.[] | "\(.name)@\(.version)\n  \(.description)\n  stažení: \(.download)\n  \(.npmInstall)\n"')
Instalátor: curl -fsSL ${RR_SERVER%/}/install.sh | bash"
}

# ----------------------------------------------------------------- main
main_menu() {
  while true; do
    local c
    c=$(UI_TITLE="Hlavní menu" menu "Správa registru – vyberte sekci" \
      1 "Stav serveru" \
      2 "Repozitáře" \
      3 "Balíčky" \
      4 "Procházet soubory" \
      5 "Hledat balíčky" \
      6 "Směrování (routing)" \
      7 "Cache" \
      8 "Uživatelé" \
      9 "Tokeny" \
      G "Git repozitáře" \
      D "Docker image" \
      W "Webhooky a události" \
      J "Replikace a naplánované úlohy" \
      S "Nastavení serveru" \
      L "Logy" \
      K "Klientské balíčky" \
      R "Přegenerovat klientské knihovny" \
      C "Připojení / přihlášení" \
      Q "Konec") || return
    case "$c" in
      1) screen_status ;;
      2) screen_repos ;;
      3) local r; r=$(pick_repo "Balíčky v repozitáři") && screen_packages "$r" ;;
      4) local r; r=$(pick_repo "Procházet repozitář") && screen_files "$r" "/" ;;
      5) screen_search ;;
      6) screen_routes ;;
      7) screen_cache ;;
      8) screen_users ;;
      9) screen_tokens ;;
      G) local r; r=$(pick_git_repo) && screen_git "$r" ;;
      D) screen_images ;;
      W) screen_webhooks ;;
      J) screen_jobs ;;
      S) screen_settings ;;
      L) screen_logs ;;
      K) screen_clients ;;
      R) yesno "Znovu vygenerovat a publikovat klientské balíčky?" && text "$(api rr_api_rebuild_clients | jq .)" ;;
      C) screen_connection ;;
      Q) return ;;
    esac
  done
}

case "${1:-}" in
  -h|--help) echo "rr-gui - RR Registry terminal GUI. Použití: rr-gui   (RR_SERVER, RR_TOKEN, RR_DIALOG=whiptail|dialog)"; exit 0 ;;
  -v|--version) echo "rr-gui $RR_API_VERSION"; exit 0 ;;
esac

if ! rr_api_status >/dev/null 2>&1; then
  msg "Server $RR_SERVER není dostupný. Nastavte adresu v menu Připojení."
  screen_connection
elif [ -z "$RR_TOKEN" ]; then
  yesno "Nejste přihlášen(a). Přihlásit se nyní?" && screen_connection
fi
main_menu
