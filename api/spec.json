{
  "name": "rr-api",
  "title": "RR Registry Management API",
  "version": "1.0.0",
  "basePath": "/api/v1",
  "auth": "Authorization: Bearer <api_token | user token>  nebo  Basic <user:password>",
  "operations": [
    {
      "id": "status",
      "group": "system",
      "method": "GET",
      "path": "/status",
      "auth": "none",
      "summary": "Stav serveru, verze, statistiky"
    },
    {
      "id": "getSpec",
      "group": "system",
      "method": "GET",
      "path": "/spec",
      "auth": "none",
      "summary": "Specifikace API (z ní se generují klientské knihovny)"
    },
    {
      "id": "listClients",
      "group": "system",
      "method": "GET",
      "path": "/clients",
      "auth": "none",
      "summary": "Seznam klientských balíčků ke stažení"
    },
    {
      "id": "rebuildClients",
      "group": "system",
      "method": "POST",
      "path": "/clients/rebuild",
      "auth": "admin",
      "summary": "Znovu vygenerovat klientské knihovny a publikovat je do registru"
    },
    {
      "id": "getLogs",
      "group": "system",
      "method": "GET",
      "path": "/logs",
      "auth": "admin",
      "query": [
        "limit",
        "type"
      ],
      "summary": "Poslední požadavky a audit log"
    },
    {
      "id": "listPlugins",
      "group": "system",
      "method": "GET",
      "path": "/plugins",
      "auth": "admin",
      "summary": "Dostupné a zapnuté pluginy"
    },
    {
      "id": "listTasks",
      "group": "system",
      "method": "GET",
      "path": "/tasks",
      "auth": "admin",
      "summary": "Naplánované úlohy (zrcadla, čištění, cache)"
    },
    {
      "id": "runTask",
      "group": "system",
      "method": "POST",
      "path": "/tasks/:id/run",
      "auth": "admin",
      "summary": "Spustit úlohu hned"
    },
    {
      "id": "login",
      "group": "auth",
      "method": "POST",
      "path": "/auth/login",
      "auth": "none",
      "body": "json",
      "summary": "Přihlášení jménem a heslem -> token {username, password}"
    },
    {
      "id": "logout",
      "group": "auth",
      "method": "POST",
      "path": "/auth/logout",
      "auth": "user",
      "summary": "Zneplatní aktuální token"
    },
    {
      "id": "whoami",
      "group": "auth",
      "method": "GET",
      "path": "/auth/whoami",
      "auth": "user",
      "summary": "Informace o přihlášeném uživateli"
    },
    {
      "id": "listRepos",
      "group": "repos",
      "method": "GET",
      "path": "/repos",
      "auth": "read",
      "summary": "Seznam repozitářů"
    },
    {
      "id": "createRepo",
      "group": "repos",
      "method": "POST",
      "path": "/repos",
      "auth": "admin",
      "body": "json",
      "summary": "Vytvořit repozitář {name, type: npm|generic|docker|git|group, description, public, allowPublish, quotaMb, immutable, acl, cleanup, members, deployTo, autoCreate}"
    },
    {
      "id": "getRepo",
      "group": "repos",
      "method": "GET",
      "path": "/repos/:repo",
      "auth": "read",
      "summary": "Detail repozitáře"
    },
    {
      "id": "updateRepo",
      "group": "repos",
      "method": "PUT",
      "path": "/repos/:repo",
      "auth": "admin",
      "body": "json",
      "summary": "Upravit repozitář {description, public, allowPublish, quotaMb, immutable, acl: {uživatel: none|read|publish}, cleanup: {enabled, maxVersions, maxAgeDays, prereleaseOnly, pattern, intervalHours}, members, deployTo, autoCreate}"
    },
    {
      "id": "deleteRepo",
      "group": "repos",
      "method": "DELETE",
      "path": "/repos/:repo",
      "auth": "admin",
      "query": [
        "purge"
      ],
      "summary": "Smazat repozitář (purge=1 smaže i soubory)"
    },
    {
      "id": "runCleanup",
      "group": "repos",
      "method": "POST",
      "path": "/repos/:repo/cleanup",
      "auth": "admin",
      "summary": "Spustit čištění dle pravidel retence {dryRun, policy?: {maxVersions, maxAgeDays, prereleaseOnly, pattern}}",
      "body": "json"
    },
    {
      "id": "getRepoStats",
      "group": "repos",
      "method": "GET",
      "path": "/repos/:repo/stats",
      "auth": "read",
      "summary": "Statistiky stahování repozitáře (celkem, nejstahovanější, posledních 30 dní)",
      "query": [
        "top"
      ]
    },
    {
      "id": "listPackages",
      "group": "packages",
      "method": "GET",
      "path": "/repos/:repo/packages",
      "auth": "read",
      "query": [
        "q"
      ],
      "summary": "Balíčky v repozitáři"
    },
    {
      "id": "uploadPackage",
      "group": "packages",
      "method": "POST",
      "path": "/repos/:repo/packages",
      "auth": "publish",
      "body": "binary",
      "query": [
        "tag"
      ],
      "summary": "Publikovat balíček z .tgz souboru"
    },
    {
      "id": "getPackage",
      "group": "packages",
      "method": "GET",
      "path": "/repos/:repo/packages/:pkg",
      "auth": "read",
      "summary": "Detail balíčku (packument)"
    },
    {
      "id": "deletePackage",
      "group": "packages",
      "method": "DELETE",
      "path": "/repos/:repo/packages/:pkg",
      "auth": "publish",
      "summary": "Smazat balíček (všechny verze)"
    },
    {
      "id": "deleteVersion",
      "group": "packages",
      "method": "DELETE",
      "path": "/repos/:repo/packages/:pkg/versions/:version",
      "auth": "publish",
      "summary": "Smazat verzi balíčku"
    },
    {
      "id": "downloadTarball",
      "group": "packages",
      "method": "GET",
      "path": "/repos/:repo/packages/:pkg/versions/:version/tarball",
      "auth": "read",
      "response": "binary",
      "summary": "Stáhnout .tgz dané verze"
    },
    {
      "id": "deprecateVersion",
      "group": "packages",
      "method": "PUT",
      "path": "/repos/:repo/packages/:pkg/versions/:version/deprecate",
      "auth": "publish",
      "body": "json",
      "summary": "Označit verzi jako zastaralou {message} (verze * = všechny)"
    },
    {
      "id": "setDistTag",
      "group": "packages",
      "method": "PUT",
      "path": "/repos/:repo/packages/:pkg/dist-tags/:tag",
      "auth": "publish",
      "body": "json",
      "summary": "Nastavit dist-tag {version}"
    },
    {
      "id": "deleteDistTag",
      "group": "packages",
      "method": "DELETE",
      "path": "/repos/:repo/packages/:pkg/dist-tags/:tag",
      "auth": "publish",
      "summary": "Smazat dist-tag"
    },
    {
      "id": "search",
      "group": "packages",
      "method": "GET",
      "path": "/search",
      "auth": "read",
      "query": [
        "q",
        "repo",
        "size"
      ],
      "summary": "Hledat balíčky ve všech npm repozitářích"
    },
    {
      "id": "tree",
      "group": "files",
      "method": "GET",
      "path": "/repos/:repo/tree",
      "auth": "read",
      "query": [
        "path",
        "depth"
      ],
      "summary": "Strom adresářů a souborů repozitáře"
    },
    {
      "id": "stat",
      "group": "files",
      "method": "GET",
      "path": "/repos/:repo/stat",
      "auth": "read",
      "query": [
        "path"
      ],
      "summary": "Informace o souboru/adresáři"
    },
    {
      "id": "readFile",
      "group": "files",
      "method": "GET",
      "path": "/repos/:repo/files",
      "auth": "read",
      "query": [
        "path"
      ],
      "response": "binary",
      "summary": "Obsah souboru"
    },
    {
      "id": "writeFile",
      "group": "files",
      "method": "PUT",
      "path": "/repos/:repo/files",
      "auth": "admin",
      "query": [
        "path"
      ],
      "body": "binary",
      "summary": "Nahrát / přepsat soubor"
    },
    {
      "id": "deleteFile",
      "group": "files",
      "method": "DELETE",
      "path": "/repos/:repo/files",
      "auth": "admin",
      "query": [
        "path"
      ],
      "summary": "Smazat soubor nebo adresář"
    },
    {
      "id": "mkdir",
      "group": "files",
      "method": "POST",
      "path": "/repos/:repo/dirs",
      "auth": "admin",
      "query": [
        "path"
      ],
      "summary": "Vytvořit adresář"
    },
    {
      "id": "listImages",
      "group": "docker",
      "method": "GET",
      "path": "/repos/:repo/images",
      "auth": "read",
      "summary": "Docker image v repozitáři {name, tags, size, updated}"
    },
    {
      "id": "listImageTags",
      "group": "docker",
      "method": "GET",
      "path": "/repos/:repo/images/:image/tags",
      "auth": "read",
      "summary": "Tagy image {tag, digest, mediaType, size, created} (název image URL-enkódovaný, např. agentconf%2Fnode)"
    },
    {
      "id": "deleteImageTag",
      "group": "docker",
      "method": "DELETE",
      "path": "/repos/:repo/images/:image/tags/:tag",
      "auth": "publish",
      "summary": "Smazat tag image (data uvolní garbage collection)"
    },
    {
      "id": "dockerGc",
      "group": "docker",
      "method": "POST",
      "path": "/repos/:repo/gc",
      "auth": "admin",
      "body": "json",
      "summary": "Garbage collection docker repozitáře {untagged: smazat i neotagované manifesty}"
    },
    {
      "id": "listGitRepos",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git",
      "auth": "read",
      "summary": "Git repozitáře v repozitáři typu git",
      "query": [
        "q"
      ]
    },
    {
      "id": "createGitRepo",
      "group": "git",
      "method": "POST",
      "path": "/repos/:repo/git",
      "auth": "publish",
      "summary": "Vytvořit git repozitář {name, description, defaultBranch} nebo importovat/zrcadlit (jen admin) {importUrl, mirror, interval, ttl, token, username}",
      "body": "json"
    },
    {
      "id": "githubImport",
      "group": "git",
      "method": "POST",
      "path": "/repos/:repo/git/github-import",
      "auth": "admin",
      "summary": "Hromadný import / zrcadlení repozitářů z GitHubu {owner, token, kind: auto|user|org|mine, mirror, interval, filter, includeForks, includeArchived, limit, prefix}",
      "body": "json"
    },
    {
      "id": "getGitRepo",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git/:name",
      "auth": "read",
      "summary": "Detail git repozitáře (větve, tagy, zrcadla, URL pro klonování)"
    },
    {
      "id": "updateGitRepo",
      "group": "git",
      "method": "PUT",
      "path": "/repos/:repo/git/:name",
      "auth": "admin",
      "summary": "Upravit git repozitář {description, defaultBranch, protectedBranches, mirror: {url, token, interval, ttl, enabled} | null}",
      "body": "json"
    },
    {
      "id": "deleteGitRepo",
      "group": "git",
      "method": "DELETE",
      "path": "/repos/:repo/git/:name",
      "auth": "admin",
      "summary": "Smazat git repozitář"
    },
    {
      "id": "gitCommits",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git/:name/commits",
      "auth": "read",
      "summary": "Historie commitů",
      "query": [
        "ref",
        "limit",
        "path"
      ]
    },
    {
      "id": "gitTree",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git/:name/tree",
      "auth": "read",
      "summary": "Obsah adresáře ve větvi/tagu/commitu",
      "query": [
        "ref",
        "path"
      ]
    },
    {
      "id": "gitBlob",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git/:name/blob",
      "auth": "read",
      "summary": "Obsah souboru ve větvi/tagu/commitu",
      "query": [
        "ref",
        "path"
      ],
      "response": "binary"
    },
    {
      "id": "gitArchive",
      "group": "git",
      "method": "GET",
      "path": "/repos/:repo/git/:name/archive",
      "auth": "read",
      "summary": "Stáhnout archiv (tar.gz/zip) větve/tagu",
      "query": [
        "ref",
        "format"
      ],
      "response": "binary"
    },
    {
      "id": "gitSync",
      "group": "git",
      "method": "POST",
      "path": "/repos/:repo/git/:name/sync",
      "auth": "publish",
      "summary": "Synchronizovat zrcadla hned {direction: pull|push|both}",
      "body": "json"
    },
    {
      "id": "addGitPushMirror",
      "group": "git",
      "method": "POST",
      "path": "/repos/:repo/git/:name/push-mirrors",
      "auth": "admin",
      "summary": "Přidat push zrcadlo {url, token, username, mode: mirror|branches, createMissing, private}",
      "body": "json"
    },
    {
      "id": "deleteGitPushMirror",
      "group": "git",
      "method": "DELETE",
      "path": "/repos/:repo/git/:name/push-mirrors/:id",
      "auth": "admin",
      "summary": "Odebrat push zrcadlo"
    },
    {
      "id": "listRoutes",
      "group": "routes",
      "method": "GET",
      "path": "/routes",
      "auth": "admin",
      "summary": "Pravidla směrování (routing plugin)"
    },
    {
      "id": "createRoute",
      "group": "routes",
      "method": "POST",
      "path": "/routes",
      "auth": "admin",
      "body": "json",
      "summary": "Přidat pravidlo {name, when: always|notfound|push, matchOn, matchType, pattern, repo, repoType, key, target, token, cacheTtl, replicateDeletes, gitMode, createMissing, ...}"
    },
    {
      "id": "getRoute",
      "group": "routes",
      "method": "GET",
      "path": "/routes/:id",
      "auth": "admin",
      "summary": "Detail pravidla"
    },
    {
      "id": "updateRoute",
      "group": "routes",
      "method": "PUT",
      "path": "/routes/:id",
      "auth": "admin",
      "body": "json",
      "summary": "Upravit pravidlo"
    },
    {
      "id": "deleteRoute",
      "group": "routes",
      "method": "DELETE",
      "path": "/routes/:id",
      "auth": "admin",
      "summary": "Smazat pravidlo"
    },
    {
      "id": "testRoute",
      "group": "routes",
      "method": "POST",
      "path": "/routes/test",
      "auth": "admin",
      "body": "json",
      "summary": "Otestovat, které pravidlo odpovídá {repo, path, key, method}"
    },
    {
      "id": "listReplications",
      "group": "routes",
      "method": "GET",
      "path": "/replications",
      "auth": "admin",
      "summary": "Fronta a historie replikací (pravidla when=push)",
      "query": [
        "limit",
        "status"
      ]
    },
    {
      "id": "retryReplication",
      "group": "routes",
      "method": "POST",
      "path": "/replications/:id/retry",
      "auth": "admin",
      "summary": "Znovu spustit replikaci"
    },
    {
      "id": "cacheStats",
      "group": "cache",
      "method": "GET",
      "path": "/cache",
      "auth": "admin",
      "summary": "Statistiky cache"
    },
    {
      "id": "listCache",
      "group": "cache",
      "method": "GET",
      "path": "/cache/entries",
      "auth": "admin",
      "query": [
        "q",
        "limit"
      ],
      "summary": "Položky v cache"
    },
    {
      "id": "purgeCache",
      "group": "cache",
      "method": "DELETE",
      "path": "/cache",
      "auth": "admin",
      "query": [
        "expired",
        "q"
      ],
      "summary": "Vyčistit cache (vše / expired=1 / q=filtr)"
    },
    {
      "id": "deleteCacheEntry",
      "group": "cache",
      "method": "DELETE",
      "path": "/cache/entries/:key",
      "auth": "admin",
      "summary": "Smazat položku cache"
    },
    {
      "id": "listWebhooks",
      "group": "webhooks",
      "method": "GET",
      "path": "/webhooks",
      "auth": "admin",
      "summary": "Webhooky"
    },
    {
      "id": "createWebhook",
      "group": "webhooks",
      "method": "POST",
      "path": "/webhooks",
      "auth": "admin",
      "summary": "Vytvořit webhook {name, url, events: [*|npm.*|git.push|...], repos, secret, format: json|slack|discord, headers, enabled}",
      "body": "json"
    },
    {
      "id": "updateWebhook",
      "group": "webhooks",
      "method": "PUT",
      "path": "/webhooks/:id",
      "auth": "admin",
      "summary": "Upravit webhook",
      "body": "json"
    },
    {
      "id": "deleteWebhook",
      "group": "webhooks",
      "method": "DELETE",
      "path": "/webhooks/:id",
      "auth": "admin",
      "summary": "Smazat webhook"
    },
    {
      "id": "testWebhook",
      "group": "webhooks",
      "method": "POST",
      "path": "/webhooks/:id/test",
      "auth": "admin",
      "summary": "Odeslat testovací událost (ping)"
    },
    {
      "id": "listWebhookDeliveries",
      "group": "webhooks",
      "method": "GET",
      "path": "/webhooks/deliveries",
      "auth": "admin",
      "summary": "Historie doručení webhooků",
      "query": [
        "id",
        "limit"
      ]
    },
    {
      "id": "listEvents",
      "group": "webhooks",
      "method": "GET",
      "path": "/events",
      "auth": "admin",
      "summary": "Poslední události a seznam typů událostí",
      "query": [
        "limit",
        "type"
      ]
    },
    {
      "id": "listUsers",
      "group": "users",
      "method": "GET",
      "path": "/users",
      "auth": "admin",
      "summary": "Uživatelé"
    },
    {
      "id": "createUser",
      "group": "users",
      "method": "POST",
      "path": "/users",
      "auth": "admin",
      "body": "json",
      "summary": "Vytvořit uživatele {name, password, email, role: admin|publisher|reader}"
    },
    {
      "id": "updateUser",
      "group": "users",
      "method": "PUT",
      "path": "/users/:name",
      "auth": "admin",
      "body": "json",
      "summary": "Upravit uživatele {password, email, role}"
    },
    {
      "id": "deleteUser",
      "group": "users",
      "method": "DELETE",
      "path": "/users/:name",
      "auth": "admin",
      "summary": "Smazat uživatele"
    },
    {
      "id": "listTokens",
      "group": "tokens",
      "method": "GET",
      "path": "/tokens",
      "auth": "user",
      "summary": "Tokeny (admin vidí všechny)"
    },
    {
      "id": "createToken",
      "group": "tokens",
      "method": "POST",
      "path": "/tokens",
      "auth": "user",
      "body": "json",
      "summary": "Vytvořit token {name, readonly, user (jen admin), ttl}"
    },
    {
      "id": "revokeToken",
      "group": "tokens",
      "method": "DELETE",
      "path": "/tokens/:id",
      "auth": "user",
      "summary": "Zneplatnit token"
    },
    {
      "id": "getSettings",
      "group": "settings",
      "method": "GET",
      "path": "/settings",
      "auth": "admin",
      "summary": "Nastavení serveru"
    },
    {
      "id": "updateSettings",
      "group": "settings",
      "method": "PUT",
      "path": "/settings",
      "auth": "admin",
      "body": "json",
      "summary": "Změnit nastavení {defaultRepo, dockerRepo, gitRepo, anonymousRead, allowRegistration, cacheTtl, tarballTtl, title, plugins}"
    },
    {
      "id": "transferSections",
      "group": "transfer",
      "method": "GET",
      "path": "/transfer/sections",
      "auth": "admin",
      "summary": "Části, které lze exportovat (sekce, položky, velikosti) v pořadí exportu/importu"
    },
    {
      "id": "listExports",
      "group": "transfer",
      "method": "GET",
      "path": "/exports",
      "auth": "admin",
      "summary": "Vytvořené exporty"
    },
    {
      "id": "createExport",
      "group": "transfer",
      "method": "POST",
      "path": "/exports",
      "auth": "admin",
      "summary": "Vytvořit šifrovaný export {passphrase, sections: [server, secret, plugins, users, tokens, repos, content, routes, webhooks, settings, stats, audit, cache], items: {sekce: [id]}, note}",
      "body": "json"
    },
    {
      "id": "downloadExport",
      "group": "transfer",
      "method": "GET",
      "path": "/exports/:id/download",
      "auth": "admin",
      "summary": "Stáhnout soubor exportu (.rrx)",
      "response": "binary"
    },
    {
      "id": "deleteExport",
      "group": "transfer",
      "method": "DELETE",
      "path": "/exports/:id",
      "auth": "admin",
      "summary": "Smazat export"
    },
    {
      "id": "listImports",
      "group": "transfer",
      "method": "GET",
      "path": "/imports",
      "auth": "admin",
      "summary": "Rozpracované a dokončené importy"
    },
    {
      "id": "uploadImport",
      "group": "transfer",
      "method": "POST",
      "path": "/imports",
      "auth": "admin",
      "summary": "Nahrát soubor exportu (.rrx) k importu",
      "body": "binary"
    },
    {
