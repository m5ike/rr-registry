{
  "$schema": "https://aitools.dev/spec/portal-app/1/schema.json",
  "contract": 1,
  "id": "registry",
  "name": "Registry",
  "version": "1.6.1",
  "description": "Private npm, Docker/OCI and git registry with caching proxy, generic repositories and admin UI. Every repository type is also served on its own host ({type}-registry.<domain>).",
  "category": "devtools",
  "icon": "web/assets/logo.svg",
  "compat": {
    "portal": ">=1.1.0 <2.0.0"
  },
  "routing": {
    "preferred": "host",
    "pathPrefix": false,
    "host": true,
    "rootPaths": [
      "/v2/",
      "/-/",
      "/api/v1/",
      "/admin/",
      "/git/"
    ],
    "dynamicHosts": "{name}-{app}.{domain}"
  },
  "services": [
    {
      "id": "web",
      "port": 4873,
      "primary": true,
      "websocket": false,
      "health": {
        "path": "/-/ping",
        "expect": "2xx",
        "intervalSec": 10
      },
      "proxy": {
        "maxBodyMB": 4096,
        "timeoutMs": 0
      }
    }
  ],
  "env": {
    "host": "RR_HOST",
    "port": "RR_PORT",
    "publicUrl": "RR_PUBLIC_URL",
    "dataDir": "RR_DATA_DIR"
  },
  "auth": {
    "mode": "portal-header",
    "require": "none",
    "roles": [
      {
        "id": "admin",
        "label": "Administrator",
        "description": "Full administration: repositories, users, tokens, settings"
      },
      {
        "id": "publisher",
        "label": "Publisher",
        "description": "Read and publish packages, images and git pushes"
      },
      {
        "id": "reader",
        "label": "Reader",
        "description": "Read / pull only"
      }
    ],
    "adminRole": "admin",
    "defaultRole": "reader"
  },
  "runtime": {
    "static": {
      "requires": [
        "node>=18",
        "git"
      ],
      "build": "node tools/build.js",
      "start": "node server/bin/rr-server.js"
    },
    "docker": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "volumes": {
        "data": "/data"
      },
      "env": {
        "RR_DATA_DIR": "/data"
      }
    }
  },
  "nav": [
    {
      "label": "Home",
      "path": "/"
    },
    {
      "label": "Admin",
      "path": "/admin/"
    },
    {
      "label": "API docs",
      "path": "/docs/"
    }
  ],
  "wellKnown": "/.well-known/portal-app.json"
}
