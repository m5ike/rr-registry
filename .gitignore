# RR Registry - files that must never be committed

# ---- configuration & secrets (generated by make menuconfig) ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
.npmrc
.netrc
secret
secrets/

# ---- runtime data (registry storage, cache, stats, audit log) ----
/data/
data/
*.pid
.rr-registry.pid

# ---- build output (generated by tools/build.js / make clients) ----
/dist/
*.tgz
*.tar.gz
*.zip

# ---- backups (scripts/backup.sh) ----
/backups/
*.bak
*.backup

# ---- dependencies ----
node_modules/
.npm/
.pnpm-store/
.yarn/
bower_components/

# ---- logs & test artifacts ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
*.lcov
tmp/
temp/
.tmp/

# ---- OS ----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- editors / IDE ----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace

# ---- local tool state ----
.claude/settings.local.json
.direnv/
.envrc
.claude/launch.json
