# RR Registry configuration - generate with `make menuconfig`
RR_PORT=4873
RR_BIND=0.0.0.0
RR_PUBLIC_URL=
RR_ADMIN_USER=admin
RR_ADMIN_PASSWORD=change-me
RR_API_TOKEN=change-me-to-a-long-random-token
RR_DEFAULT_REPO=npm
RR_UPSTREAM=https://registry.npmjs.org
RR_CACHE_TTL=300
RR_MAX_BODY_MB=200
RR_DATA_PATH=./data
RR_CONTAINER=rr-registry
RR_UID=1000
RR_GID=1000
RR_LOG_REQUESTS=1
